{
  "openapi": "3.1.0",
  "info": {
    "title": "Phone API 명세서",
    "description": "핸드폰 중복 방지 API 문서입니다.",
    "version": "v0.0.2"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "equipment",
      "description": "장비 관련 API"
    },
    {
      "name": "Health",
      "description": "헬스 체크 API Test"
    },
    {
      "name": "inventory",
      "description": "인벤토리 관련 API (조회, 수령)"
    },
    {
      "name": "auth",
      "description": "인증 관련 API"
    },
    {
      "name": "user",
      "description": "user 관련 API (생성, 조회, 변경)"
    }
  ],
  "paths": {
    "/api/v1/user": {
      "get": {
        "tags": [
          "user"
        ],
        "summary": "유저 정보 조회",
        "description": "기존 유저 정보 조회",
        "operationId": "getProfile",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "user"
        ],
        "summary": "유저 정보 등록",
        "description": "신규 유저 정보 등록",
        "operationId": "setupProfile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserProfileSetupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "user"
        ],
        "summary": "유저 정보 부분 수정",
        "description": "기존 유저 정보 부분 수정",
        "operationId": "updateProfile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserProfileUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/inventory/grant": {
      "post": {
        "tags": [
          "inventory"
        ],
        "operationId": "grantItem",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GrantItemRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/equipment/equip": {
      "post": {
        "tags": [
          "equipment"
        ],
        "summary": "장비 장착",
        "description": "장비 장착 요청 처리",
        "operationId": "equip",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EquipRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CharacterEquipmentResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "토큰 갱신",
        "description": "Refresh Token → 새 Access Token 발급",
        "operationId": "refreshToken",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TokenRefreshResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/kakao": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "카카오 로그인",
        "description": "카카오 Access Token → AT + RT 발급",
        "operationId": "kakaoLogin",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KakaoLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/KakaoLoginResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "서버 상태 확인",
        "description": "서버 상태를 반환합니다.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/inventory/{userId}": {
      "get": {
        "tags": [
          "inventory"
        ],
        "operationId": "getInventory",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserItemResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/equipment/{userId}": {
      "get": {
        "tags": [
          "equipment"
        ],
        "summary": "착용 장비 확인",
        "description": "현재 장비 착용 상태를 반환합니다.",
        "operationId": "getEquipment",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CharacterEquipmentResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/equipment/{userId}/{slotType}": {
      "delete": {
        "tags": [
          "equipment"
        ],
        "summary": "장비 해제",
        "description": "장비 해제 요청 처리",
        "operationId": "unequip",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "slotType",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "HAIR",
                "TOP",
                "BOTTOM",
                "SHOES"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UserProfileSetupRequest": {
        "type": "object",
        "properties": {
          "nickname": {
            "type": "string"
          },
          "birthDate": {
            "type": "string",
            "format": "date"
          },
          "gender": {
            "type": "string",
            "enum": [
              "MALE",
              "FEMALE",
              "UNKNOWN"
            ]
          },
          "dailyScreenTimeGoalMinutes": {
            "type": "integer",
            "format": "int32"
          },
          "timeZone": {
            "type": "string"
          },
          "dayStartTime": {
            "type": "string"
          },
          "dayEndTime": {
            "type": "string"
          },
          "reportTime": {
            "type": "string"
          }
        }
      },
      "GrantItemRequest": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "itemId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "EquipRequest": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "itemId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "CharacterEquipmentResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "slotType": {
            "type": "string"
          },
          "item": {
            "$ref": "#/components/schemas/ItemResponse"
          }
        }
      },
      "ItemResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "itemType": {
            "type": "string"
          },
          "slotType": {
            "type": "string"
          },
          "rarity": {
            "type": "string"
          },
          "assetAddress": {
            "type": "string"
          },
          "priceType": {
            "type": "string"
          },
          "currencyPrice": {
            "type": "integer",
            "format": "int32"
          },
          "premiumPrice": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "TokenRefreshRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "TokenRefreshResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          }
        }
      },
      "KakaoLoginRequest": {
        "type": "object",
        "properties": {
          "kakaoAccessToken": {
            "type": "string"
          }
        }
      },
      "KakaoLoginResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "isNewUser": {
            "type": "boolean"
          }
        }
      },
      "UserProfileUpdateRequest": {
        "type": "object",
        "properties": {
          "nickname": {
            "type": "string"
          },
          "birthDate": {
            "type": "string",
            "format": "date"
          },
          "gender": {
            "type": "string",
            "enum": [
              "MALE",
              "FEMALE",
              "UNKNOWN"
            ]
          },
          "dailyScreenTimeGoalMinutes": {
            "type": "integer",
            "format": "int32"
          },
          "timeZone": {
            "type": "string"
          },
          "dayStartTime": {
            "type": "string"
          },
          "dayEndTime": {
            "type": "string"
          },
          "reportTime": {
            "type": "string"
          }
        }
      },
      "UserItemResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "item": {
            "$ref": "#/components/schemas/ItemResponse"
          },
          "acquiredAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}