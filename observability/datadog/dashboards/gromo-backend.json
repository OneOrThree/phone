{
  "title": "gromo 백엔드 관측 (APM·JVM·인프라·로그)",
  "description": "gromo Spring Boot 백엔드 통합 관측 대시보드. env·service 템플릿 변수로 dev/prod 전환. GROMO-927.",
  "layout_type": "ordered",
  "reflow_type": "fixed",
  "template_variables": [
    { "name": "env", "prefix": "env", "available_values": [], "default": "prod" },
    { "name": "service", "prefix": "service", "available_values": [], "default": "gromo-back-prod" }
  ],
  "widgets": [
    {
      "layout": { "x": 0, "y": 0, "width": 12, "height": 3 },
      "definition": {
        "title": "① 개요 (SLO 핵심 지표)",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "layout": { "x": 0, "y": 0, "width": 2, "height": 2 },
            "definition": {
              "title": "Throughput (req/s)",
              "type": "query_value",
              "requests": [
                { "q": "sum:trace.servlet.request.hits{$service,$env}.as_rate()", "aggregator": "avg" }
              ],
              "autoscale": true,
              "precision": 2
            }
          },
          {
            "layout": { "x": 2, "y": 0, "width": 2, "height": 2 },
            "definition": {
              "title": "에러율 (%)",
              "type": "query_value",
              "requests": [
                { "q": "100 * sum:trace.servlet.request.errors{$service,$env}.as_count() / sum:trace.servlet.request.hits{$service,$env}.as_count()", "aggregator": "avg", "conditional_formats": [ { "comparator": ">", "value": 5, "palette": "white_on_red" }, { "comparator": ">", "value": 1, "palette": "white_on_yellow" }, { "comparator": "<=", "value": 1, "palette": "white_on_green" } ] }
              ],
              "precision": 2
            }
          },
          {
            "layout": { "x": 4, "y": 0, "width": 2, "height": 2 },
            "definition": {
              "title": "지연 p95 (요청)",
              "type": "query_value",
              "requests": [ { "q": "p95:trace.servlet.request{$service,$env}", "aggregator": "avg" } ],
              "autoscale": true,
              "precision": 1
            }
          },
          {
            "layout": { "x": 6, "y": 0, "width": 2, "height": 2 },
            "definition": {
              "title": "지연 p99 (요청)",
              "type": "query_value",
              "requests": [ { "q": "p99:trace.servlet.request{$service,$env}", "aggregator": "avg" } ],
              "autoscale": true,
              "precision": 1
            }
          },
          {
            "layout": { "x": 8, "y": 0, "width": 2, "height": 2 },
            "definition": {
              "title": "JVM 힙 사용",
              "type": "query_value",
              "requests": [ { "q": "avg:jvm.heap_memory{$service,$env}", "aggregator": "avg" } ],
              "autoscale": true,
              "custom_unit": "B",
              "precision": 1
            }
          }
        ]
      }
    },
    {
      "layout": { "x": 0, "y": 3, "width": 12, "height": 10 },
      "definition": {
        "title": "② APM — 트래픽·지연·에러",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "layout": { "x": 0, "y": 0, "width": 6, "height": 3 },
            "definition": {
              "title": "요청 지연 (p50 / p95 / p99)",
              "type": "timeseries",
              "requests": [
                { "q": "p50:trace.servlet.request{$service,$env}", "display_type": "line", "style": { "palette": "cool", "line_type": "solid", "line_width": "normal" } },
                { "q": "p95:trace.servlet.request{$service,$env}", "display_type": "line", "style": { "palette": "warm", "line_type": "solid", "line_width": "normal" } },
                { "q": "p99:trace.servlet.request{$service,$env}", "display_type": "line", "style": { "palette": "orange", "line_type": "solid", "line_width": "thick" } }
              ],
              "show_legend": true
            }
          },
          {
            "layout": { "x": 6, "y": 0, "width": 6, "height": 3 },
            "definition": {
              "title": "Throughput vs 에러 (req/s)",
              "type": "timeseries",
              "requests": [
                { "q": "sum:trace.servlet.request.hits{$service,$env}.as_rate()", "display_type": "bars", "style": { "palette": "cool" } },
                { "q": "sum:trace.servlet.request.errors{$service,$env}.as_rate()", "display_type": "bars", "style": { "palette": "warm" } }
              ],
              "show_legend": true
            }
          },
          {
            "layout": { "x": 0, "y": 3, "width": 6, "height": 3 },
            "definition": {
              "title": "에러율 (%)",
              "type": "timeseries",
              "requests": [
                { "q": "100 * sum:trace.servlet.request.errors{$service,$env}.as_count() / sum:trace.servlet.request.hits{$service,$env}.as_count()", "display_type": "line", "style": { "palette": "warm", "line_width": "thick" } }
              ],
              "show_legend": false
            }
          },
          {
            "layout": { "x": 6, "y": 3, "width": 6, "height": 3 },
            "definition": {
              "title": "엔드포인트별 요청수 Top 15",
              "type": "toplist",
              "requests": [
                { "q": "top(sum:trace.servlet.request.hits{$service,$env} by {resource_name}.as_count(), 15, 'sum', 'desc')" }
              ]
            }
          },
          {
            "layout": { "x": 0, "y": 6, "width": 6, "height": 3 },
            "definition": {
              "title": "느린 엔드포인트 Top 15 (p95)",
              "type": "toplist",
              "requests": [
                { "q": "top(p95:trace.servlet.request{$service,$env} by {resource_name}, 15, 'mean', 'desc')" }
              ]
            }
          }
        ]
      }
    },
    {
      "layout": { "x": 0, "y": 13, "width": 12, "height": 7 },
      "definition": {
        "title": "③ DB (APM JDBC 쿼리)",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "layout": { "x": 0, "y": 0, "width": 6, "height": 3 },
            "definition": {
              "title": "DB 쿼리 지연 (p95 / p99)",
              "type": "timeseries",
              "requests": [
                { "q": "p95:trace.jdbc.query{$env}", "display_type": "line", "style": { "palette": "cool" } },
                { "q": "p99:trace.jdbc.query{$env}", "display_type": "line", "style": { "palette": "orange", "line_width": "thick" } }
              ],
              "show_legend": true
            }
          },
          {
            "layout": { "x": 6, "y": 0, "width": 6, "height": 3 },
            "definition": {
              "title": "DB Throughput vs 에러 (req/s)",
              "type": "timeseries",
              "requests": [
                { "q": "sum:trace.jdbc.query.hits{$env}.as_rate()", "display_type": "bars", "style": { "palette": "cool" } },
                { "q": "sum:trace.jdbc.query.errors{$env}.as_rate()", "display_type": "bars", "style": { "palette": "warm" } }
              ],
              "show_legend": true
            }
          },
          {
            "layout": { "x": 0, "y": 3, "width": 6, "height": 3 },
            "definition": {
              "title": "느린 쿼리 Top 15 (p95)",
              "type": "toplist",
              "requests": [
                { "q": "top(p95:trace.jdbc.query{$env} by {resource_name}, 15, 'mean', 'desc')" }
              ]
            }
          },
          {
            "layout": { "x": 6, "y": 3, "width": 6, "height": 3 },
            "definition": {
              "title": "쿼리 호출량 Top 15",
              "type": "toplist",
              "requests": [
                { "q": "top(sum:trace.jdbc.query.hits{$env} by {resource_name}.as_count(), 15, 'sum', 'desc')" }
              ]
            }
          }
        ]
      }
    },
    {
      "layout": { "x": 0, "y": 20, "width": 12, "height": 10 },
      "definition": {
        "title": "④ JVM 런타임",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "layout": { "x": 0, "y": 0, "width": 6, "height": 3 },
            "definition": {
              "title": "힙 메모리 (사용 vs 최대)",
              "type": "timeseries",
              "requests": [
                { "q": "avg:jvm.heap_memory{$service,$env}", "display_type": "area", "style": { "palette": "cool" } },
                { "q": "avg:jvm.heap_memory_max{$service,$env}", "display_type": "line", "style": { "palette": "grey", "line_type": "dashed" } }
              ],
              "show_legend": true
            }
          },
          {
            "layout": { "x": 6, "y": 0, "width": 6, "height": 3 },
            "definition": {
              "title": "Non-Heap 메모리",
              "type": "timeseries",
              "requests": [ { "q": "avg:jvm.non_heap_memory{$service,$env}", "display_type": "area", "style": { "palette": "purple" } } ]
            }
          },
          {
            "layout": { "x": 0, "y": 3, "width": 6, "height": 3 },
            "definition": {
              "title": "GC 시간 (minor / major)",
              "type": "timeseries",
              "requests": [
                { "q": "avg:jvm.gc.minor_collection_time{$service,$env}", "display_type": "bars", "style": { "palette": "cool" } },
                { "q": "avg:jvm.gc.major_collection_time{$service,$env}", "display_type": "bars", "style": { "palette": "warm" } }
              ],
              "show_legend": true
            }
          },
          {
            "layout": { "x": 6, "y": 3, "width": 6, "height": 3 },
            "definition": {
              "title": "스레드 수",
              "type": "timeseries",
              "requests": [ { "q": "avg:jvm.thread_count{$service,$env}", "display_type": "line", "style": { "palette": "green" } } ]
            }
          },
          {
            "layout": { "x": 0, "y": 6, "width": 6, "height": 3 },
            "definition": {
              "title": "JVM CPU 부하 (process / system)",
              "type": "timeseries",
              "requests": [
                { "q": "avg:jvm.cpu_load.process{$service,$env}", "display_type": "line", "style": { "palette": "cool" } },
                { "q": "avg:jvm.cpu_load.system{$service,$env}", "display_type": "line", "style": { "palette": "grey" } }
              ],
              "show_legend": true
            }
          }
        ]
      }
    },
    {
      "layout": { "x": 0, "y": 30, "width": 12, "height": 10 },
      "definition": {
        "title": "⑤ 인프라 (컨테이너·호스트)",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "layout": { "x": 0, "y": 0, "width": 6, "height": 3 },
            "definition": {
              "title": "컨테이너 CPU (%)",
              "type": "timeseries",
              "requests": [ { "q": "avg:docker.cpu.usage{$env} by {container_name}", "display_type": "line" } ],
              "show_legend": true
            }
          },
          {
            "layout": { "x": 6, "y": 0, "width": 6, "height": 3 },
            "definition": {
              "title": "컨테이너 메모리 RSS",
              "type": "timeseries",
              "requests": [ { "q": "avg:docker.mem.rss{$env} by {container_name}", "display_type": "area" } ],
              "show_legend": true
            }
          },
          {
            "layout": { "x": 0, "y": 3, "width": 6, "height": 3 },
            "definition": {
              "title": "호스트 Load (1m)",
              "type": "timeseries",
              "requests": [ { "q": "avg:system.load.1{$env} by {host}", "display_type": "line" } ]
            }
          },
          {
            "layout": { "x": 6, "y": 3, "width": 6, "height": 3 },
            "definition": {
              "title": "호스트 메모리 사용",
              "type": "timeseries",
              "requests": [ { "q": "avg:system.mem.used{$env} by {host}", "display_type": "area", "style": { "palette": "cool" } } ]
            }
          },
          {
            "layout": { "x": 0, "y": 6, "width": 6, "height": 3 },
            "definition": {
              "title": "디스크 사용률",
              "type": "timeseries",
              "requests": [ { "q": "avg:system.disk.in_use{$env} by {host,device}", "display_type": "line" } ]
            }
          }
        ]
      }
    },
    {
      "layout": { "x": 0, "y": 40, "width": 12, "height": 5 },
      "definition": {
        "title": "⑥ 로그",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "layout": { "x": 0, "y": 0, "width": 6, "height": 3 },
            "definition": {
              "title": "로그 볼륨 (status별)",
              "type": "timeseries",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    { "data_source": "logs", "name": "logs", "search": { "query": "$env $service" }, "indexes": [ "*" ], "compute": { "aggregation": "count" }, "group_by": [ { "facet": "status", "limit": 10, "sort": { "aggregation": "count", "order": "desc" } } ] }
                  ],
                  "formulas": [ { "formula": "logs" } ],
                  "display_type": "bars"
                }
              ],
              "show_legend": true
            }
          },
          {
            "layout": { "x": 6, "y": 0, "width": 6, "height": 4 },
            "definition": {
              "title": "에러·경고 로그 스트림",
              "type": "log_stream",
              "query": "$env $service status:(error OR warn)",
              "indexes": [ "*" ],
              "columns": [ "host", "service", "status" ],
              "show_date_column": true,
              "show_message_column": true,
              "message_display": "expanded-md",
              "sort": { "column": "time", "order": "desc" }
            }
          }
        ]
      }
    }
  ]
}
