# Gromo 앱 환경 변수 예시 — 복사해서 app/.env로 사용하세요
#   cp app/.env.example app/.env
#
# 기본값: 팀 서버 연결 (백엔드 직접 실행 불필요)
EXPO_PUBLIC_API_URL=https://example.com
REACT_NATIVE_PACKAGER_HOSTNAME=localhost

# 로컬 백엔드로 전환하려면 DevRunbook.md "3.2 백엔드 연결 모드 선택" 참고
# 실기기 연결 시 IP 대신 mDNS 호스트명 사용 (IP 변경에 무관): scutil --get LocalHostName
# EXPO_PUBLIC_API_URL=http://<호스트명>.local:8080
# REACT_NATIVE_PACKAGER_HOSTNAME=<호스트명>.local
