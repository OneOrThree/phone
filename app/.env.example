EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_ENV = dev
APP_VERSION = 0.0.1

# Google 소셜 로그인 (GROMO-400)
# web client ID = 백엔드 GOOGLE_CLIENT_ID 와 동일 (id_token aud 검증)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client ID = GoogleService-Info.plist 의 CLIENT_ID (현재 단일 클라이언트라 web 값과 동일)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# LINE 소셜 로그인 (GROMO-400)
# LINE Developers Console > 채널(LINE Login) 의 Channel ID. 발급 후 채운다. (채널 시크릿은 불필요)
EXPO_PUBLIC_LINE_CHANNEL_ID=

# Meta(Facebook) 소셜 로그인 (GROMO-400 / GROMO-501)
# App ID(공개). ⚠️ App Secret 은 여기/FE 에 넣지 말 것 — BE 서버 환경변수 전용.
EXPO_PUBLIC_FACEBOOK_APP_ID=
# Client Token(Meta 콘솔 > 설정 > 고급). App Secret 과 다름.
EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=