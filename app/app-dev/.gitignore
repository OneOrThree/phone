# 같이숲 v2 앱의 로컬 의존성·빌드·검증 산출물

node_modules/
.expo/
.omc/
.env*
!.env.example
dist/
dist-all/
releases/
build/
web-build/
web-preview.log
coverage/
*.ipa
*.dSYM.zip
npm-debug.*
*.log
*.tsbuildinfo
*.orig.*
.docs
