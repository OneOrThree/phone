<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <queries>
    <intent><action android:name="android.settings.SETTINGS" /></intent>
    <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.HOME" /></intent>
    <intent><action android:name="android.intent.action.SHOW_ALARMS" /></intent>
    <intent><action android:name="android.intent.action.DIAL" /><data android:scheme="tel" /></intent>
  </queries>
  <application>
    <service android:name=".FocusReturnService" android:label="@string/focus_return_label"
      android:exported="true" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/focus_return_accessibility" />
    </service>
    <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
  </application>
</manifest>
