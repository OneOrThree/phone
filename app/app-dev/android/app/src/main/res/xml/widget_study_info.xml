<?xml version="1.0" encoding="utf-8"?>
<!-- 홈 위젯 메타데이터(GROMO-1006) — 3x2 셀 기본, 홈 화면 전용.
     갱신은 데이터 저장 시 명시 갱신(StudyWidgetProvider.updateAll)이 주 경로.
     updatePeriodMillis는 보수적으로 1시간 — 스냅샷이 묵으면 빈 상태로 되돌리는
     보정용(OS 최소 제약 30분). 자정 경계는 주기 갱신에만 맡기지 않고
     StudyWidgetProvider가 다음 로컬 자정에 inexact 알람으로 명시 갱신한다(코드리뷰 반영).
     minResizeWidth는 레이아웃 설계 폭인 minWidth와 동일하게(코드리뷰 반영) —
     행 하나가 패딩(루트 14×2+행 10×2=48dp)·고정폭(점 8+여백 7+8=23dp)·
     타이머 00:00:00(13sp bold ≈55dp)만으로 ~126dp를 쓰므로 110dp에선 반드시 잘린다.
     180dp면 과목명에 ~54dp(한글 약 4자)가 남는다.
     minHeight/minResizeHeight도 실측 기반(코드리뷰 반영) — 세로 고정 소요가
     루트 패딩 14×2=28dp + 제목 한 줄(13sp≈18dp) + 행 마진 8+6=14dp +
     행 패딩 7×2×2=28dp + 행 텍스트 두 줄(13sp≈18dp×2)=36dp ≈ 124dp라
     110dp에선 두 번째 행이 잘린다. 폰트 패딩 여유를 더해 130dp.
     (minResizeHeight는 minHeight보다 크면 무시되므로 둘을 함께 올린다.) -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="130dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="130dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="3600000"
    android:initialLayout="@layout/widget_study"
    android:previewLayout="@layout/widget_study"
    android:description="@string/widget_study_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
