      "title": "집중한 사람의 하루 집중시간",
      "description": "최근 28일 동안 실제 집중을 완료한 사람들의 하루 총 집중시간을 평균과 중앙값으로 보여줍니다. 그날 집중하지 않은 사람은 계산에서 제외합니다.",
      "query": {
        "kind": "DataVisualizationNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "WITH filtered_events AS (SELECT * FROM events WHERE {filters}), valid_events AS (\n SELECT person_id, toDate(toTimeZone(timestamp, 'Asia/Seoul')) AS focus_day,\n  toFloatOrNull(toString(properties.duration_seconds)) AS duration_seconds\n FROM filtered_events\n WHERE properties.analytics_environment = 'production'\n  AND event = 'focus_completed'\n  AND toDate(toTimeZone(timestamp, 'Asia/Seoul')) >= toDate(toTimeZone(now(), 'Asia/Seoul')) - INTERVAL 27 DAY\n  AND timestamp <= now()\n), per_user_day AS (\n SELECT person_id, focus_day, sum(duration_seconds) / 60.0 AS focus_minutes\n FROM valid_events\n WHERE duration_seconds > 0\n GROUP BY person_id, focus_day\n)\nSELECT focus_day AS \"날짜\",\n round(avg(focus_minutes), 2) AS \"사용자당 평균 집중분\",\n round((quantileExact(0.5)(focus_minutes) - quantileExact(0.5)(-focus_minutes)) / 2.0, 2) AS \"사용자당 중앙값 집중분\",\n count() AS \"유효 집중완료 사용자\"\nFROM per_user_day\nGROUP BY focus_day\nORDER BY focus_day",
          "filters": {
            "filterTestAccounts": true
          }
        },
