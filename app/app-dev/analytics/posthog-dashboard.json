      "order": 4,
      "insight_id": 12957829,
      "title": "첫 집중 후 다시 집중한 비율",
      "description": "최근 28일에 첫 실제 집중을 완료한 사람 중 다음 날·7일 뒤·그 사이 다른 날에 다시 집중을 완료한 비율입니다. 해당 날짜가 지난 사람만 비교합니다.",
      "query": {
        "kind": "DataVisualizationNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "WITH filtered_events AS (SELECT * FROM events WHERE {filters}), first_milestone AS (\n SELECT person_id, min(timestamp) AS first_completed_at\n FROM filtered_events\n WHERE event = 'activation_step'\n  AND properties.analytics_environment = 'production'\n  AND properties.activation_schema_version = 1\n  AND properties.journey = 'first_island'\n  AND properties.stage = 'first_focus_completed'\n  AND toFloatOrNull(toString(properties.duration_seconds)) > 0\n GROUP BY person_id\n), cohort AS (\n SELECT person_id, toDate(toTimeZone(first_completed_at, 'Asia/Seoul')) AS cohort_day\n FROM first_milestone\n WHERE toDate(toTimeZone(first_completed_at, 'Asia/Seoul')) >= toDate(toTimeZone(now(), 'Asia/Seoul')) - INTERVAL 27 DAY\n  AND first_completed_at <= now()\n), return_days AS (\n SELECT person_id, toDate(toTimeZone(timestamp, 'Asia/Seoul')) AS focus_day\n FROM filtered_events\n WHERE event = 'focus_completed'\n  AND properties.analytics_environment = 'production'\n  AND toFloatOrNull(toString(properties.duration_seconds)) > 0\n  AND toDate(toTimeZone(timestamp, 'Asia/Seoul')) >= toDate(toTimeZone(now(), 'Asia/Seoul')) - INTERVAL 27 DAY\n  AND timestamp <= now()\n GROUP BY person_id, focus_day\n), per_user AS (\n SELECT c.person_id, c.cohort_day,\n  max(if(r.focus_day = c.cohort_day + INTERVAL 1 DAY, 1, 0)) AS returned_d1,\n  max(if(r.focus_day = c.cohort_day + INTERVAL 7 DAY, 1, 0)) AS returned_d7,\n  max(if(r.focus_day > c.cohort_day AND r.focus_day <= c.cohort_day + INTERVAL 7 DAY, 1, 0)) AS returned_d1_d7\n FROM cohort c\n LEFT JOIN return_days r ON c.person_id = r.person_id\n GROUP BY c.person_id, c.cohort_day\n), stats AS (\n SELECT\n  countIf(cohort_day + INTERVAL 1 DAY < toDate(toTimeZone(now(), 'Asia/Seoul'))) AS d1_n,\n  countIf(cohort_day + INTERVAL 1 DAY < toDate(toTimeZone(now(), 'Asia/Seoul')) AND returned_d1 = 1) AS d1_returned,\n  countIf(cohort_day + INTERVAL 7 DAY < toDate(toTimeZone(now(), 'Asia/Seoul'))) AS d7_n,\n  countIf(cohort_day + INTERVAL 7 DAY < toDate(toTimeZone(now(), 'Asia/Seoul')) AND returned_d7 = 1) AS d7_returned,\n  countIf(cohort_day + INTERVAL 7 DAY < toDate(toTimeZone(now(), 'Asia/Seoul')) AND returned_d1_d7 = 1) AS range_returned\n FROM per_user\n)\nSELECT\n nullIf(d1_n, 0) AS \"D1 성숙 분모\",\n if(d1_n = 0, NULL, d1_returned) AS \"D1 재집중 사용자\",\n round(100.0 * d1_returned / nullIf(d1_n, 0), 2) AS \"D1 재집중율 퍼센트\",\n nullIf(d7_n, 0) AS \"D7 성숙 분모\",\n if(d7_n = 0, NULL, d7_returned) AS \"D7 재집중 사용자\",\n round(100.0 * d7_returned / nullIf(d7_n, 0), 2) AS \"D7 재집중율 퍼센트\",\n if(d7_n = 0, NULL, range_returned) AS \"D1~D7 재집중 사용자\",\n round(100.0 * range_returned / nullIf(d7_n, 0), 2) AS \"D1~D7 재집중율 퍼센트\"\nFROM stats",
          "filters": {
            "filterTestAccounts": true
          }
        },
        "display": "ActionsTable"
      },
      "show_description": true
    },
