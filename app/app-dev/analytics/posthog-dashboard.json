      "order": 6,
      "insight_id": 12957029,
      "title": "매일 이용한 사람과 집중한 사람",
      "description": "최근 28일의 날짜별 앱 이용자 수와 집중 완료자 수입니다. 같은 날 여러 번 사용한 사람은 한 명으로 세며, 오늘 수치는 하루가 끝날 때까지 늘어납니다.",
      "query": {
        "kind": "DataVisualizationNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "WITH filtered_events AS (SELECT * FROM events WHERE {filters})\nSELECT\n toDate(toTimeZone(timestamp, 'Asia/Seoul')) AS \"날짜\",\n nullIf(uniqExactIf(person_id, event = 'app_active'), 0) AS \"활성 사용자\",\n nullIf(uniqExactIf(person_id, event = 'focus_completed'), 0) AS \"집중완료 사용자\"\nFROM filtered_events\nWHERE properties.analytics_environment = 'production'\n AND toDate(toTimeZone(timestamp, 'Asia/Seoul')) >= toDate(toTimeZone(now(), 'Asia/Seoul')) - INTERVAL 27 DAY\n AND timestamp <= now()\n AND event IN ('app_active', 'focus_completed')\nGROUP BY \"날짜\"\nORDER BY \"날짜\"",
          "filters": {
            "filterTestAccounts": true
          }
        },
