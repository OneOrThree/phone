      "order": 5,
      "insight_id": 12957028,
      "title": "최근 7일 이용과 집중 습관",
      "description": "최근 7일 동안 앱을 이용한 사람, 집중을 완료한 사람, 서로 다른 3일 이상 집중을 완료한 사람의 수입니다. 같은 사람이 여러 번 사용해도 각 항목에서 한 명으로 셉니다.",
      "query": {
        "kind": "DataVisualizationNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "WITH filtered_events AS (SELECT * FROM events WHERE {filters}), user_days AS (\n SELECT person_id,\n  countIf(event = 'app_active') AS active_events,\n  uniqExactIf(toDate(toTimeZone(timestamp, 'Asia/Seoul')), event = 'focus_completed') AS focus_days\n FROM filtered_events\n WHERE properties.analytics_environment = 'production'\n  AND toDate(toTimeZone(timestamp, 'Asia/Seoul')) >= toDate(toTimeZone(now(), 'Asia/Seoul')) - INTERVAL 6 DAY\n  AND timestamp <= now()\n  AND event IN ('app_active', 'focus_completed')\n GROUP BY person_id\n)\nSELECT\n nullIf(countIf(active_events > 0), 0) AS \"활성 사용자\",\n nullIf(countIf(focus_days > 0), 0) AS \"집중완료 사용자\",\n if(countIf(focus_days > 0) = 0, NULL, countIf(focus_days >= 3)) AS \"3일 이상 집중완료 사용자\"\nFROM user_days",
          "filters": {
            "filterTestAccounts": true
          }
        },
        "display": "ActionsTable"
      },
      "show_description": true
    },
