default_platform(:ios)
opt_out_usage

APP_ID = "com.oneorthree.focuscat".freeze
IOS_DIR = File.expand_path("..", __dir__).freeze
DIST_PROFILES = {
  APP_ID => "distribution-cat-main",
}.freeze

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH"),
  )
end

def marketing_version
  File.read(File.join(IOS_DIR, "GROMO.xcodeproj/project.pbxproj"))[/MARKETING_VERSION = ([\d.]+)/, 1]
end

def compute_build_number(api_key)
  latest = latest_testflight_build_number(
    api_key: api_key,
    app_identifier: APP_ID,
    version: marketing_version,
    initial_build_number: 0,
  )
  latest.to_i + 1
end

platform :ios do
  before_all do
    Dir.chdir(IOS_DIR)
  end

  desc "Fishcat 테스트 빌드 → TestFlight 업로드"
  lane :beta do
    api_key = asc_api_key
    build_number = compute_build_number(api_key)

    increment_build_number(
      xcodeproj: File.join(IOS_DIR, "GROMO.xcodeproj"),
      build_number: build_number,
    )
    build_app(
      workspace: File.join(IOS_DIR, "GROMO.xcworkspace"),
      scheme: "GROMO",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: DIST_PROFILES,
      },
    )
    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_ID,
      skip_waiting_for_build_processing: true,
    )
  end
end
