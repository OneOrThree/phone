# App Store Connect API 키 — testflight.sh / fastlane 이 TestFlight 업로드와 프로비저닝에 쓴다.
# 이 파일을 .env 로 복사해 채운다. .env 는 gitignore 돼 있어 커밋되지 않는다.
# CI 러너에서는 이 파일 대신 러너의 환경변수(~/actions-runner/.env)로 같은 세 값을 준다.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
ASC_KEY_PATH=/Users/<me>/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8
