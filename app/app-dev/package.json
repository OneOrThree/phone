{
  "name": "gromo-island-demo",
  "version": "2.0.0",
  "private": true,
  "main": "index",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "build:all": "expo export --platform all --output-dir dist-all",
    "prebuild": "expo prebuild",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "review:buttons": "node scripts/review-all-buttons.cjs",
    "review:journeys": "node scripts/review-journeys.cjs",
    "review:first-user": "node scripts/review-first-user.cjs",
    "screens:capture": "node scripts/capture-phone-screens.cjs",
    "screens:html": "python3 scripts/build-phone-gallery.py",
    "review:v2": "node scripts/review-current-v2.cjs",
    "review:v2-journeys": "node scripts/review-v2-journeys.cjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@stomp/stompjs": "^7.3.0",
    "expo": "~57.0.8",
    "expo-audio": "~57.0.3",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.1",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/plugin-syntax-jsx": "^7.29.7",
    "@react-native/eslint-config": "^0.86.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.2",
    "@types/react": "~19.2.4",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "~29.7.0",
    "jest-expo": "57.0.2",
    "playwright": "1.63.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3"
  }
}
