{
  "name": "cattus-web-api",
  "main": "api-worker.mjs",
  "account_id": "8cbd6c2d55cdebe173eae6a5957eaa82",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "keep_vars": true,
  "routes": [
    {
      "pattern": "try.oneorthree.world/service-api/*",
