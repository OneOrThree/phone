# 2.0 앱 환경 변수 예시 — `cp .env.example .env` 뒤 값을 채운다. `.env` 는 커밋하지 않는다.
# EXPO_PUBLIC_* 는 번들에 그대로 박혀 앱 사용자에게 노출된다 — 서버 비밀을 넣지 않는다.
# 값을 바꾸면 Metro 를 다시 띄운다(번들이 뜰 때 읽는다).
# 목록은 src·app.config.js 가 실제로 읽는 키다(2026-10-07 기준).

# API 진입점. 팀 dev 서버 또는 로컬 nginx(실기기는 맥 LAN IP, 예: http://192.168.0.10:8088)
EXPO_PUBLIC_API_URL=https://oneorthree.dev.mooo.com

# 약관 버전 — 비우면 소셜 로그인 버튼과 회원 전환이 숨는다(src/services/termsVersion.ts). release 빌드는 필수.
EXPO_PUBLIC_TERMS_VERSION=
# iOS Apple 로그인 버튼 공개. release 빌드는 1 이어야 한다.
EXPO_PUBLIC_APPLE_LOGIN_ENABLED=1
# Google 로그인 Web 클라이언트 id(토큰 aud). 서버 GOOGLE_CLIENT_ID 허용 목록에 있어야 한다.
# 비우면 src/services/socialLogin.ts 의 기본값을 쓴다. iOS 클라이언트 id 는 코드에 고정돼 있다.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# LINE 채널 id — 현재 로그인 화면에 노출하지 않는다(계정 정책 LOGIN-D04). 비우면 코드 기본값.
EXPO_PUBLIC_LINE_CHANNEL_ID=

# 관측 — Datadog RUM(비우면 꺼진다), 환경 태그(비우면 개발 빌드 dev, 그 외 prod)
EXPO_PUBLIC_DATADOG_APPLICATION_ID=
EXPO_PUBLIC_DATADOG_CLIENT_TOKEN=
EXPO_PUBLIC_ENV=
# 분석 — PostHog. 개발 빌드는 EXPO_PUBLIC_POSTHOG_DEV_ENABLED=1 일 때만 보낸다. 호스트 기본값 https://us.i.posthog.com
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=
EXPO_PUBLIC_POSTHOG_HOST=
EXPO_PUBLIC_POSTHOG_DEV_ENABLED=

# 마을 미리보기 — 개발 빌드는 항상 켜져 있고, release 에서 켜려면 1
EXPO_PUBLIC_VILLAGE_PREVIEW=

# 로컬 Metro 를 실기기에 붙일 때만 — 맥 LAN IP
# REACT_NATIVE_PACKAGER_HOSTNAME=
