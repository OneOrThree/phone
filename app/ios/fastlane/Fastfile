default_platform(:ios)
opt_out_usage

# 7개 타겟 → 배포(distribution) 프로비저닝 프로파일 매핑 (수동 서명)
# 프로파일 이름은 gromo.xcodeproj 의 PROVISIONING_PROFILE_SPECIFIER 와 일치해야 한다.
DIST_PROFILES = {
  "com.oneorthree.gromo"                    => "distribution-gromo-main",
  "com.oneorthree.gromo.screentimemonitor"  => "distribution-gromo-screentimemonitor",
  "com.oneorthree.gromo.screentimereport"   => "distribution-gromo-screentimereport",
  "com.oneorthree.gromo.notificationservice" => "distribution-gromo-notificationservice",
  "com.oneorthree.gromo.shieldconfig"       => "distribution-gromo-shieldconfiguration",
  "com.oneorthree.gromo.shieldaction"       => "distribution-gromo-shieldaction",
  "com.oneorthree.gromo.widget"             => "distribution-gromo-widget",
}.freeze

APP_ID = "com.oneorthree.gromo".freeze

platform :ios do
  desc "빌드(archive) → TestFlight 업로드"
  lane :beta do
    # 1. App Store Connect API Key (.p8) 로 인증 — Apple ID 비번 불필요
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"), # AuthKey_XXXX.p8 경로
    )

    # 2. 빌드번호 = max(ASC 최신 빌드, 로컬 프로젝트 현재 빌드) + 1
    #    ASC API는 전파 지연으로 방금 올린 빌드를 아직 최신으로 안 줄 때가 있다
    #    (그 값만 믿고 +1 하면 이미 쓴 번호를 또 만들어 -19232 "already used"로 거부됨).
    #    increment_build_number가 매번 gromo.xcodeproj에 값을 다시 써두므로,
    #    로컬 현재 빌드번호는 항상 마지막에 올린 값 이상이다 → 이걸 하한으로 같이 쓰면
    #    ASC가 늦어도 로컬 값이 앞서 있어 자동으로 +1 되고 충돌하지 않는다.
    version = get_info_plist_value(path: "gromo/Info.plist", key: "CFBundleShortVersionString")
    asc_latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_ID,
      version: version,
      initial_build_number: 0,
    ).to_i
    local_current = get_build_number(xcodeproj: "gromo.xcodeproj").to_i
    # BUILD_NUMBER_FLOOR: 그래도 막히면 쓰는 수동 하한 (평소엔 불필요)
    floor = ENV.fetch("BUILD_NUMBER_FLOOR", "0").to_i
    next_build = [asc_latest + 1, local_current + 1, floor].max
    UI.message("빌드번호: ASC=#{asc_latest}, 로컬=#{local_current}, floor=#{floor} → #{next_build}")
    increment_build_number(
      xcodeproj: "gromo.xcodeproj",
      build_number: next_build,
    )

    # 3. archive → .ipa (RN/JS 번들은 Xcode 빌드 단계에서 자동 포함)
    build_app(
      workspace: "gromo.xcworkspace",
      scheme: "gromo",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: DIST_PROFILES,
      },
    )

    # 4. TestFlight 업로드 (처리 완료까지 대기 안 함)
    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_ID,
      skip_waiting_for_build_processing: true,
    )
  end
end
