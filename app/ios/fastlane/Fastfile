default_platform(:ios)
opt_out_usage

# 7개 타겟 → 배포(distribution) 프로비저닝 프로파일 매핑 (수동 서명)
# 프로파일 이름은 gromo.xcodeproj 의 PROVISIONING_PROFILE_SPECIFIER 와 일치해야 한다.
DIST_PROFILES = {
  "com.oneorthree.gromo"                    => "distribution-gromo-main",
  "com.oneorthree.gromo.screentimemonitor"  => "distribution-gromo-screentimemonitor",
  "com.oneorthree.gromo.screentimereport"   => "distribution-gromo-screentimereport",
  "com.oneorthree.gromo.notificationservice" => "distribution-gromo-notificationservice",
  "com.oneorthree.gromo.shieldconfig"       => "distribution-gromo-shieldconfiguration",
  "com.oneorthree.gromo.shieldaction"       => "distribution-gromo-shieldaction",
  "com.oneorthree.gromo.widget"             => "distribution-gromo-widget",
}.freeze

APP_ID = "com.oneorthree.gromo".freeze

platform :ios do
  desc "빌드(archive) → TestFlight 업로드"
  lane :beta do
    # 1. App Store Connect API Key (.p8) 로 인증 — Apple ID 비번 불필요
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"), # AuthKey_XXXX.p8 경로
    )

    # 2. 빌드번호 = 현재 유닉스 타임스탬프 (매번 유일 + 항상 단조 증가)
    #    이 프로젝트는 GENERATE_INFOPLIST_FILE=YES 라, 바이너리의 CFBundleVersion은
    #    CURRENT_PROJECT_VERSION(= increment_build_number 가 쓰는 값)에서 나온다.
    #    (gromo/Info.plist 의 리터럴 CFBundleVersion 값은 빌드 시 이 값으로 덮인다.)
    #
    #    "ASC 최신 빌드 + 1" 방식은 두 이유로 계속 -19232("already used") 충돌이 났다:
    #      (1) CFBundleShortVersionString 이 "$(MARKETING_VERSION)" 문자 그대로라
    #          latest_testflight_build_number 가 그런 버전을 못 찾고 항상 0을 반환,
    #      (2) expo prebuild 가 CURRENT_PROJECT_VERSION 을 app.config.js 의 '1'로 되돌려
    #          매 실행이 1→2 로만 올라가 이미 쓴 번호를 재생성.
    #    타임스탬프는 ASC 전파 지연/prebuild 리셋과 무관하게 매번 커지므로 충돌이 불가능하다.
    #    Time.now.to_i(≈17억) < 42.9억(CFBundleVersion 컴포넌트 상한)이라 2106년까지 안전.
    next_build = Time.now.to_i
    UI.message("빌드번호(타임스탬프): #{next_build}")
    increment_build_number(
      xcodeproj: "gromo.xcodeproj",
      build_number: next_build,
    )

    # 3. archive → .ipa (RN/JS 번들은 Xcode 빌드 단계에서 자동 포함)
    build_app(
      workspace: "gromo.xcworkspace",
      scheme: "gromo",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: DIST_PROFILES,
      },
    )

    # 4. TestFlight 업로드 (처리 완료까지 대기 안 함)
    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_ID,
      skip_waiting_for_build_processing: true,
    )
  end
end
