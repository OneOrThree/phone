<?xml version="1.0" encoding="utf-8"?>
<!-- 홈 위젯 메타데이터(GROMO-1006) — 3x2 셀 기본, 홈 화면 전용.
     갱신은 데이터 저장 시 명시 갱신(StudyWidgetProvider.updateAll)이 주 경로.
     updatePeriodMillis는 보수적으로 1시간 — 자정이 지나 스냅샷이 묵으면
     다음 주기 갱신에서 빈 상태로 되돌리는 보정용(OS 최소 제약 30분). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="3600000"
    android:initialLayout="@layout/widget_study"
    android:previewLayout="@layout/widget_study"
    android:description="@string/widget_study_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
