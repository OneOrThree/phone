<?xml version="1.0" encoding="utf-8"?>
<!--
  다른 과목 칩 배경 — iOS Live Activity의 chipBg(#F1F2F8) + chipBorder(#E3E5EE) 자리.

  iOS는 배너 배경을 흰색(paper)으로 고정하므로 회색 칩을 그대로 쓸 수 있다. 안드로이드 알림은
  시스템이 배경을 그리고 다크 테마에서 어두워지므로, 같은 회색을 박으면 다크에서 칩이 사라진다.
  그래서 **포인트색(accent #5E6AD2)의 저알파**로 칠한다 — 라이트/다크 어디서든 같은 인디고
  기운이 남고 대비도 유지된다.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <corners android:radius="10dp" />
  <solid android:color="#1F5E6AD2" />
  <stroke android:width="1dp" android:color="#3D5E6AD2" />
</shape>
