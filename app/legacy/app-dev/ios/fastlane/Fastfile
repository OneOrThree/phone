default_platform(:ios)
opt_out_usage

# 7개 타겟 → 배포(distribution) 프로비저닝 프로파일 매핑 (수동 서명)
# 프로파일 이름은 gromo.xcodeproj 의 PROVISIONING_PROFILE_SPECIFIER 와 일치해야 한다.
DIST_PROFILES = {
  "com.oneorthree.gromo"                    => "distribution-gromo-main",
  "com.oneorthree.gromo.screentimemonitor"  => "distribution-gromo-screentimemonitor",
  "com.oneorthree.gromo.screentimereport"   => "distribution-gromo-screentimereport",
  "com.oneorthree.gromo.notificationservice" => "distribution-gromo-notificationservice",
  "com.oneorthree.gromo.shieldconfig"       => "distribution-gromo-shieldconfiguration",
  "com.oneorthree.gromo.shieldaction"       => "distribution-gromo-shieldaction",
  "com.oneorthree.gromo.widget"             => "distribution-gromo-widget",
}.freeze

APP_ID = "com.oneorthree.gromo".freeze

# 이 Fastfile(app/ios/fastlane) 기준 app/ios 절대경로. fastlane 액션·파일 접근이 실행 CWD/root 와
# 무관하게 동작하도록 프로젝트·버전 파일 경로를 전부 이 절대경로로 앵커링한다.
IOS_DIR = File.expand_path("..", __dir__).freeze

# App Store Connect API Key (.p8) 로 인증 — Apple ID 비번 불필요.
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH"), # AuthKey_XXXX.p8 경로
  )
end

# 마케팅 버전 = pbxproj 의 MARKETING_VERSION 리터럴 (expo prebuild 가 app.config.js 의 version 에서 채움).
# Info.plist 의 CFBundleShortVersionString 은 "$(MARKETING_VERSION)" 문자 그대로라 버전 소스로 못 쓴다.
def marketing_version
  File.read(File.join(IOS_DIR, "gromo.xcodeproj/project.pbxproj"))[/MARKETING_VERSION = ([\d.]+)/, 1]
end

# 빌드번호 결정:
#  - 1.0.0(잔여 빌드): 유닉스 타임스탬프 유지. 이미 1784550135 까지 써서 Apple 규칙상
#    같은 버전 내 빌드번호를 더 작은 순차값으로 되돌릴 수 없다.
#  - 그 외 버전(1.0.1/1.1.0…): ASC 의 해당 버전 최신 빌드번호 + 1 (첫 빌드면 1) — 읽기 쉬운 순차.
# 과거 "ASC 최신 +1" 방식이 항상 0 을 반환해 -19232("already used") 충돌이 났던 원인은
# latest_testflight_build_number 에 리터럴("$(MARKETING_VERSION)")이 넘어가서였다 →
# 실제 버전 문자열(marketing_version)을 version: 으로 명시해 회피한다.
def compute_build_number(api_key)
  mv = marketing_version
  if mv == "1.0.0"
    n = Time.now.to_i
    UI.message("빌드번호(1.0.0 타임스탬프): #{n}")
    n
  else
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_ID,
      version: mv,
      initial_build_number: 0,
    )
    n = latest.to_i + 1
    UI.message("빌드번호(#{mv} 순차): #{n}")
    n
  end
end

# 어노테이티드 태그 설명 = 직전 앱 태그(app-*) 이후의 커밋 요약을 자동 포함.
def release_tag_message(tag, build_number)
  prev = sh("git describe --tags --match 'app-*' --abbrev=0 2>/dev/null || true", log: false).strip
  range = prev.empty? ? "" : "#{prev}..HEAD"
  log = sh("git log #{range} --oneline", log: false).strip
  header = "#{tag} (빌드 #{build_number})"
  prev.empty? ? "#{header}\n\n#{log}" : "#{header}\n\n직전 태그(#{prev}) 이후 포함 커밋:\n#{log}"
end

platform :ios do
  # 실행 CWD 고정 — Fastfile의 상대경로(marketing_version의 File.read, increment_build_number의
  # xcodeproj, VERSION_FILES 등)는 모두 app/ios 기준이다. 일부 fastlane/ruby 버전은 실행 CWD를
  # fastlane/ 로 잡아 이 경로들이 어긋나므로, 모든 레인 전에 이 Fastfile의 부모(app/ios)로 고정한다.
  before_all do
    Dir.chdir(File.expand_path("..", __dir__))
  end

  # 공통: 빌드번호 세팅 → archive → TestFlight 업로드. beta/release 가 공유한다.
  private_lane :build_and_upload do |options|
    increment_build_number(
      xcodeproj: File.join(IOS_DIR, "gromo.xcodeproj"),
      build_number: options[:build_number],
    )
    # archive → .ipa (RN/JS 번들은 Xcode 빌드 단계에서 자동 포함)
    build_app(
      workspace: File.join(IOS_DIR, "gromo.xcworkspace"),
      scheme: "gromo",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: DIST_PROFILES,
      },
    )
    # TestFlight 업로드 (처리 완료까지 대기 안 함)
    upload_to_testflight(
      api_key: options[:api_key],
      app_identifier: APP_ID,
      skip_waiting_for_build_processing: true,
    )
  end

  desc "테스트 빌드 → TestFlight 업로드 (태그 없음)"
  lane :beta do
    api_key = asc_api_key
    build_and_upload(api_key: api_key, build_number: compute_build_number(api_key))
  end

  # release 레인이 빌드 전에 되돌려야 할 버전 파일 (increment_build_number 가 수정)
  VERSION_FILES = [
    File.join(IOS_DIR, "gromo.xcodeproj/project.pbxproj"),
    File.join(IOS_DIR, "gromo/Info.plist"),
  ].freeze

  desc "심사 제출용 빌드 → TestFlight 업로드 + 빌드번호 커밋·태그·푸시 (arelease/* 에서만)"
  lane :release do
    # 1) 미커밋 변경 금지 — 태그가 항상 '실제 빌드된 코드'를 가리키게 한다.
    ensure_git_status_clean
    # 2) arelease/* 브랜치에서만 — 심사 빌드는 릴리즈 유지보수 라인에서 나와야 한다.
    branch = sh("git rev-parse --abbrev-ref HEAD", log: false).strip
    unless branch.start_with?("arelease/")
      UI.user_error!("release 레인은 arelease/* 브랜치에서만 실행할 수 있어요 (현재: #{branch}). 심사 빌드는 릴리즈 라인에서 내보내세요.")
    end
    # 3) 원격과 동기화 확인 — 뒤처지거나 갈라진 로컬로 빌드하면 옛 코드가 올라가고
    #    빌드번호만 낭비된다(마지막 push 는 non-fast-forward 로 거부되지만 이미 늦음).
    sh("git fetch origin #{branch} 2>/dev/null || true", log: false)
    remote = sh("git rev-parse --verify --quiet origin/#{branch} || true", log: false).strip
    unless remote.empty?
      local = sh("git rev-parse HEAD", log: false).strip
      unless local == remote
        UI.user_error!("로컬 #{branch}가 origin/#{branch}와 어긋나 있어요 (로컬 #{local[0, 7]} / 원격 #{remote[0, 7]}). git pull/push 로 동기화 후 다시 실행하세요.")
      end
    end

    api_key = asc_api_key
    build_number = compute_build_number(api_key)

    # 4) 빌드 + 업로드. 실패하면 increment_build_number 가 바꾼 버전 파일을 원복해,
    #    다음 재시도가 더티 트리 가드(1번)에 막히지 않게 한다.
    begin
      build_and_upload(api_key: api_key, build_number: build_number)
    rescue => e
      sh("git checkout -- #{VERSION_FILES.join(' ')}", log: false)
      UI.error("빌드/업로드 실패 — 빌드번호 변경을 원복했어요. 원인 확인 후 그대로 다시 실행하면 됩니다.")
      raise e
    end

    # 5) 마무리 — 빌드번호 커밋 → 어노테이티드 태그 → 브랜치·태그 push.
    #    빌드 산출물(.ipa 등)은 전부 gitignore 라 아래 두 파일만 커밋된다.
    #    커밋 메시지는 티켓 중립(자동 생성분이라 특정 티켓에 귀속되지 않음).
    git_commit(
      path: VERSION_FILES,
      message: "chore: 빌드번호 #{build_number} 반영 (release 레인 자동)",
    )
    tag = "app-#{marketing_version}-#{build_number}"
    add_git_tag(tag: tag, message: release_tag_message(tag, build_number))
    # 브랜치 push 후 '방금 만든 태그 하나만' push (tags: true = 로컬 태그 전부라 오염 위험).
    push_to_git_remote(tags: false)
    sh("git push origin #{tag}", log: false)
    UI.success("심사 제출용 빌드 완료 — 빌드번호 #{build_number}, 태그 #{tag} 푸시됨")
  end
end
