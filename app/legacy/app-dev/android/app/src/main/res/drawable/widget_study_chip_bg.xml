<?xml version="1.0" encoding="utf-8"?>
<!-- 홈 위젯 과목 칩 배경(GROMO-1006) — iOS 잠금화면 칩(chipBg/chipBorder)과 같은 톤 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
  <solid android:color="@color/widget_chip_bg" />
  <stroke
      android:width="1dp"
      android:color="@color/widget_chip_border" />
  <corners android:radius="10dp" />
</shape>
