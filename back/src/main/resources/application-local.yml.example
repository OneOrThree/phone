# application-local.yml 템플릿 — 이 파일을 같은 폴더에 application-local.yml 로 복사해서 쓰세요.
# (application-local.yml 은 .gitignore 대상이라 저장소에 커밋되지 않습니다.)
#
# ⚠️ GROMO-670 이후 필수: spring.flyway.enabled: false 를 반드시 유지하세요.
#   Flyway 의존성(spring-boot-flyway)이 추가돼 기본적으로 Flyway 가 활성화되는데, local 은
#   ddl-auto: update 로 스키마를 관리하므로 Flyway 를 끄지 않으면, 이미 만들어진 로컬 스키마에
#   V1__baseline.sql 을 실행하려다(베이스라인 마킹 없음) bootRun 이 실패합니다.
#
# ℹ️ ShedLock(GROMO-1283): `shedlock` 테이블은 JPA 엔티티가 아니라 V45 마이그레이션에서만 생기는데
#   local 은 Flyway 를 끄므로 스키마에 없습니다. common/config/ShedLockSchemaInitializer 가
#   local·ci 프로파일에서 부팅 시 같은 DDL 로 만들어 주므로 손으로 만들 필요는 없습니다 —
#   그 빈이 없으면 모든 크론이 첫 락 쿼리에서 relation "shedlock" does not exist 로 죽습니다.
spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/tt_db
    username: jajo
    password: jajo
    driver-class-name: org.postgresql.Driver
  jpa:
    show-sql: true
    hibernate:
      ddl-auto: update
  # local 은 Flyway 미개입(위 주석 참조). 이 줄을 지우거나 true 로 바꾸지 마세요.
  flyway:
    enabled: false

decorator:
  datasource:
    p6spy:
      enable-logging: true

logging:
  level:
    org.hibernate.SQL: DEBUG
    org.hibernate.orm.jdbc.bind: TRACE

# 초대 링크 (GROMO 그룹 초대 링크) — 로컬은 아무 값이나 두면 된다.
link:
  base-url: http://localhost:8080
  match-window-hours: 3
  ip-salt: local-salt
  store-ios-url: https://apps.apple.com/kr/app/gromo-grow-motivation/id6774498679

# ⬇️ 아래 블록은 기본값 없는 @Value 라 하나라도 빠지면 bootRun 이 부팅 중 죽는다
#   (Could not resolve placeholder 'jwt.secret' 등). dev/prod 는 환경변수로 주입받고
#   base application.yml 은 gitignore 라 로컬 체크아웃엔 없으므로 여기서 채워 준다.
#   값은 ci 프로파일과 같은 공개 엔드포인트다 — 웹 로컬 디버그는 게스트 로그인만 쓰므로
#   소셜 client-id 가 실제 값일 필요는 없다(auth.web.ts).
kakao:
  api-base-url: https://kapi.kakao.com

apple:
  jwks-url: https://appleid.apple.com/auth/keys
  client-id: com.oneorthree.gromo

google:
  jwks-url: https://www.googleapis.com/oauth2/v3/certs
  client-id: local-google-client-id

line:
  api-base-url: https://api.line.me

instagram:
  api-base-url: https://graph.instagram.com

facebook:
  jwks-url: https://www.facebook.com/.well-known/oauth/openid/jwks/
  client-id: "990121817063522"

# HMAC-SHA256 이라 256bit(32자) 이상이어야 한다. 로컬 전용 더미값.
jwt:
  secret: local-debug-secret-key-that-is-at-least-256-bits-long-padded-for-hmac
  access-expiration: 2592000
  refresh-expiration: 2592000
