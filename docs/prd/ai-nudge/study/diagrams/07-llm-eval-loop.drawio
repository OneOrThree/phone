        <mxCell id="score" value="⑨ 자동 채점 — 시험지 전 케이스 재시험&#10;숫자 보존·스키마·금칙어·길이 (채점기는 if문이다)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
