        <mxCell id="p2" value="프롬프트 조립&#10;숫자는 코드가 계산해 넣음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="235" y="224" width="160" height="58" as="geometry" />
