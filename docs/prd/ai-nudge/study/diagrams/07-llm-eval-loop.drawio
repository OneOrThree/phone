<mxfile host="app.diagrams.net" agent="claude-code" version="24.7.17">
  <diagram id="evalloop" name="평가 기반 LLM 개발 루프">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="470" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="평가 기반 LLM 개발 루프 — 채점지가 API 호출 코드보다 먼저다" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="6" width="640" height="28" as="geometry" />
        </mxCell>

        <mxCell id="zoneDesign" value="설계 — API 호출 코드보다 먼저 (①~⑤)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="44" width="980" height="112" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="① 목표 정의&#10;운영부담·효과를 수치로&#10;(폴백률 &lt;5% · 검수 0건)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="78" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="②③ 검수 기준 + In→Out 시험지&#10;대표 입력 30케이스와 기대 출력을 미리" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="370" y="78" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="④⑤ 채점지 + 벤치마크 시트(엑셀)&#10;행=케이스 · 열=프롬프트 버전별 점수" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="78" width="292" height="60" as="geometry" />
        </mxCell>

        <mxCell id="zonePipe" value="⑥⑦⑧ 실행 파이프라인" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="30" y="190" width="920" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="전처리&#10;(이미지면 OpenCV 등)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="55" y="224" width="160" height="58" as="geometry" />
