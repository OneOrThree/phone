<mxfile host="app.diagrams.net" agent="claude-code" version="24.7.17">
  <diagram id="rulegates" name="판정 게이트 체인">
    <mxGraphModel dx="1100" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="1040" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="판정 게이트 체인 — 하나라도 걸리면 침묵 (침묵이 기본값)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="12" width="560" height="28" as="geometry" />
        </mxCell>

        <mxCell id="start" value="매일 21:00 (KST) 크론 — 유저마다 판정 시작" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="50" width="440" height="44" as="geometry" />
        </mxCell>
        <mxCell id="prep" value="이번 주 월~오늘 누적 vs 지난주 월~같은 요일 누적&#10;양쪽에 데이터 있는 날만 짝지어 합산 (교집합 비교)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="118" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="① 지난주 유효일 ≥ 5일?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="206" width="440" height="46" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="② 짝지어진 날 ≥ 3일?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="280" width="440" height="46" as="geometry" />
        </mxCell>
        <mxCell id="delta" value="Δ = 이번 주 − 지난주 → 부호가 경고/격려를 가른다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="354" width="440" height="44" as="geometry" />
        </mxCell>
        <mxCell id="g34" value="③④ 방향별 임계 통과?&#10;경고(Δ&gt;0): 증가율 +20% 이상 AND 증가량 +30분 이상&#10;격려(Δ&lt;0): 감소율 20% 이상 AND 감소량 30분 이상" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="426" width="440" height="96" as="geometry" />
        </mxCell>
        <mxCell id="g56" value="⑤⑥ 격려 전용 게이트 — 오늘이 일요일? · 그 주 측정 대상 불변?&#10;(경고는 이 칸을 건너뜀 = 자동 통과)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="550" width="440" height="72" as="geometry" />
        </mxCell>
        <mxCell id="g7" value="⑦ 어제 발송 없음? (연속 2일 금지)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="650" width="440" height="46" as="geometry" />
        </mxCell>
        <mxCell id="g8" value="⑧ 이번 주 발송 &lt; 3회? (경고+격려 합산 · notification_sent_logs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="724" width="440" height="46" as="geometry" />
        </mxCell>
        <mxCell id="g9" value="⑨ 오늘 이 유저가 받은 총 푸시 &lt; 3건? (자기 침묵)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="798" width="440" height="46" as="geometry" />
        </mxCell>
        <mxCell id="copy" value="문구 축 하나만 선택&#10;격려 → 주 총합(일요일) → 같은 요일(오늘 급증) → 누적(기본)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="872" width="440" height="64" as="geometry" />
        </mxCell>
        <mxCell id="send" value="판정 통과 — 발송 계층으로 → 04-delivery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
