<mxfile host="app.diagrams.net" agent="claude-code" version="24.7.17">
  <diagram id="delivery" name="발송 체인">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="440" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="발송 체인 — 판정 통과 후에도 3개 필터, 그리고 기록이 다음 판정을 먹인다" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="640" height="28" as="geometry" />
        </mxCell>

        <mxCell id="input" value="판정 통과&#10;문구·숫자 확정" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="chain" value="PushNotificationService.sendIfAllowed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="56" width="450" height="120" as="geometry" />
        </mxCell>
        <mxCell id="fA" value="알림 설정 off?&#10;→ 드랍" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="258" y="94" width="126" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fB" value="FCM 토큰 없음?&#10;→ 드랍" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="94" width="126" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fC" value="조용한 시간 23~07?&#10;→ 드랍 (연기 아님!)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="542" y="94" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dropnote" value="드랍 = 조용히 사라짐 — 재시도·아침 연기 없음" style="text;html=1;align=center;fontSize=10;fontColor=#b85450;" vertex="1" parent="1">
