        <mxCell id="fcm" value="FCM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="730" y="80" width="100" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lock" value="APNs&#10;→ 잠금화면" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="870" y="80" width="130" height="70" as="geometry" />
        </mxCell>

        <mxCell id="focusnote" value="21:00엔 선객이 둘 있다&#10;평일: 오늘 미집중 · 일요일: 스트릭 위기 (22시 겹침을 피해 일요일만 이동)&#10;→ 겹침은 게이트 ⑨가 흡수 — 단 선객들이 미로깅 타입이라 기록 추가가 선행" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="330" height="100" as="geometry" />
        </mxCell>

        <mxCell id="logs" value="notification_sent_logs&#10;발송 기록 (타입 · 시각)&#10;기존 쿨다운 인프라 그대로" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;size=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="262" width="260" height="108" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;" edge="1" parent="1" source="input" target="chain"><mxGeometry relative="1" as="geometry" /></mxCell>
