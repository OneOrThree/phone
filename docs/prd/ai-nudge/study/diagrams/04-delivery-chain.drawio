        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;" edge="1" parent="1" source="fcm" target="lock"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="성공 시 기록" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="fcm" target="logs"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="다음 판정의 게이트 ⑦⑧⑨ 입력 (피드백 루프)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;dashed=1;fontSize=10;fontColor=#6c8ebf;" edge="1" parent="1" source="logs" target="input"><mxGeometry relative="1" as="geometry" /></mxCell>
