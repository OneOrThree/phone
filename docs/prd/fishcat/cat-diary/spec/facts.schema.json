{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cat-diary-facts/1",
  "title": "고양이 일기 수치 계약 v1",
  "description": "서버가 한 사용자의 한 주(KST 월 00:00 ~ 다음 월 00:00)로 만드는 LLM 입력. 숫자는 전부 표시 문자열이다. 사용자가 쓴 글(섬 이름·닉네임·방명록)은 넣지 않는다. 정본 설명: ../prompt.md §2.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "week_label", "is_first_diary", "focus", "attendance", "island", "screen_time", "highlights", "missing"],
  "properties": {
    "schema": { "const": "cat-diary-facts/1" },
    "week_label": {
      "description": "그 주의 월요일이 속한 달과 주차. 예: 11월 둘째 주",
      "type": "string",
      "pattern": "^(1[0-2]|[1-9])월 (첫째|둘째|셋째|넷째|다섯째) 주$"
    },
    "is_first_diary": {
      "description": "이 사용자가 받는 첫 고양이 일기인가",
      "type": "boolean"
    },
    "focus": {
      "description": "그 주에 끝난 집중. 집중이 한 번도 없으면 null(0분을 숫자로 보내지 않는다). 측정 실패가 아니라 실제로 안 한 것이므로 missing 에는 넣지 않는다",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/focus" }]
    },
    "attendance": {
      "description": "출석 기록(GROMO-2855 출석 기능). 기록이 없으면 null 이고 missing 에 attendance 가 있다",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/attendance" }]
    },
    "island": {
      "description": "사용자가 지금 속한 섬. 섬이 없으면(바다 항해 중) null",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/island" }]
    },
    "screen_time": {
      "description": "측정 앱 사용 시간(사용자가 고른 앱만). 측정이 없으면 null 이고 missing 에 screen_time 이 있다",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/screen_time" }]
    },
    "highlights": {
      "description": "서버가 고정 목록에서 고른, 그 주에 눈에 띄는 사실. 첫 항목이 일기의 중심이다",
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/sentence" }
    },
    "missing": {
      "description": "측정이 없어 값이 비어 있는 항목. 일기는 이 항목을 말하지 않는다",
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["attendance", "screen_time"] }
    }
  },
  "allOf": [
    {
      "description": "활동이 하나도 없는 주는 facts 를 만들지 않고 고정 문구를 보낸다",
      "anyOf": [
        { "properties": { "focus": { "type": "object" } } },
        { "properties": { "attendance": { "type": "object" } } }
      ]
    },
    {
      "if": { "properties": { "attendance": { "type": "null" } } },
      "then": { "properties": { "missing": { "contains": { "const": "attendance" } } } },
      "else": { "properties": { "missing": { "not": { "contains": { "const": "attendance" } } } } }
    },
    {
      "if": { "properties": { "screen_time": { "type": "null" } } },
      "then": { "properties": { "missing": { "contains": { "const": "screen_time" } } } },
      "else": { "properties": { "missing": { "not": { "contains": { "const": "screen_time" } } } } }
    }
  ],
  "$defs": {
    "duration": {
      "description": "시간 표시 문자열. 예: 7시간 20분 · 2시간 · 45분",
      "type": "string",
      "pattern": "^([1-9][0-9]*시간( ([1-9]|[1-5][0-9])분)?|([1-9]|[1-5][0-9])분)$"
    },
    "days": {
      "type": "string",
      "pattern": "^[1-7]일$"
    },
    "trend": {
      "description": "지난주와 비교. none 은 지난주 기록이 없음",
      "enum": ["up", "same", "down", "none"]
    },
    "sentence": {
      "description": "서버 고정 문장. 「~다」로 끝난다",
      "type": "string",
      "minLength": 4,
      "maxLength": 40,
      "pattern": "^[^<>{}]+다$"
    },
    "focus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "days", "best_weekday", "best_day_total", "trend", "trend_amount"],
      "properties": {
        "total": { "$ref": "#/$defs/duration" },
        "days": { "$ref": "#/$defs/days" },
        "best_weekday": { "enum": ["월요일", "화요일", "수요일", "목요일", "금요일", "토요일", "일요일"] },
        "best_day_total": { "$ref": "#/$defs/duration" },
        "trend": { "$ref": "#/$defs/trend" },
        "trend_amount": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/duration" }] }
      },
      "if": { "properties": { "trend": { "enum": ["up", "down"] } } },
      "then": { "properties": { "trend_amount": { "$ref": "#/$defs/duration" } } },
      "else": { "properties": { "trend_amount": { "type": "null" } } }
    },
    "attendance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["days"],
      "properties": {
        "days": { "$ref": "#/$defs/days" }
      }
    },
    "island": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank_band", "fish_in", "events"],
      "properties": {
        "rank_band": {
          "description": "주민 1명당 집중으로 매긴 전체 섬 중 위치. 상위 절반 밖이면 null(일기에서 말하지 않는다)",
          "oneOf": [{ "type": "null" }, { "enum": ["상위 10%", "상위 20%", "상위 30%", "상위 50%"] }]
        },
        "fish_in": {
          "description": "그 주 섬 통장에 들어온 물고기. 0 이면 null",
          "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[1-9][0-9]*마리$" }]
        },
        "events": {
          "description": "그 주에 끝난 건설·퀘스트 같은 섬 사건. 서버 고정 문장",
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/sentence" }
        }
      }
    },
    "screen_time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["daily_avg", "trend", "trend_amount"],
      "properties": {
        "daily_avg": { "$ref": "#/$defs/duration" },
        "trend": { "$ref": "#/$defs/trend" },
        "trend_amount": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/duration" }] }
      },
      "if": { "properties": { "trend": { "enum": ["up", "down"] } } },
      "then": { "properties": { "trend_amount": { "$ref": "#/$defs/duration" } } },
      "else": { "properties": { "trend_amount": { "type": "null" } } }
    }
  }
}
