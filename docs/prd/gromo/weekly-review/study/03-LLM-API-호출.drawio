        <mxCell id="det1" value="SQL 집계&#10;(총량·Δ%·완주율·최장 세션)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
