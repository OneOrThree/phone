        <mxCell id="det" value="서버 (결정론적 — 같은 입력이면 항상 같은 출력)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1">
