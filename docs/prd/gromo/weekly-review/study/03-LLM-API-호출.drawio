          <mxGeometry x="800" y="510" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="vfail" value="어느 그물이든 걸리면: 재시도 1회 → 또 실패 시 폴백 템플릿 문장으로 발행&#10;llm_status = fallback (폴백률 모니터링 — 5편)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
