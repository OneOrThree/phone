          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vtitle" value="응답 검증 4중 그물 — 모델 응답은 &quot;외부 입력&quot;으로 취급" style="text;html=1;align=left;fontSize=13;fontStyle=1;" vertex="1" parent="1">
