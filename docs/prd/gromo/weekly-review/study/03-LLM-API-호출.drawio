<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="anatomy" name="호출 해부도">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="server" value="우리 서버 — LLM 클라이언트" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="360" height="330" as="geometry" />
        </mxCell>
        <mxCell id="reqmodel" value="model: 어떤 모델 쓸지&#10;(품질 vs 비용 선택)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="reqsystem" value="system: 역할 + 규칙&#10;&quot;계산 금지 · 입력에 있는&#10;숫자만 · JSON으로만&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="230" y="100" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="reqmsg" value="messages: 집계 JSON&#10;(원본 로그 아님 —&#10;계산이 끝난 결과만)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="150" height="60" as="geometry" />
