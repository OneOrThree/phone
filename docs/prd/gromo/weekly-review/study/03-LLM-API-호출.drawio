          <mxGeometry x="60" y="270" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="claude" value="Claude API&#10;(Anthropic 서버 —&#10;모델은 저쪽에 있다.&#10;우리는 GPU·모델 파일·&#10;ML 지식 필요 없음)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="130" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="resp" value="응답&#10;content: 모델이 쓴 텍스트 (JSON &quot;모양&quot;일 뿐, 보장 아님)&#10;usage: 쓴 토큰 수 → 비용 로그로 저장" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="330" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ereq" value="HTTPS POST /v1/messages (수 초 소요)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;exitX=1;exitY=0.4;entryX=0;entryY=0.4;" edge="1" parent="1" source="server" target="claude">
