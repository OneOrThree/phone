        <mxCell id="hand" value="계산이 끝난 집계 JSON만 전달&#10;(산수할 기회 자체를 주지 않는다)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="det" target="prob">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="screen" value="리포트 화면 = 서버가 만든 숫자 문장 (틀릴 수 없음) + LLM이 만든 해석·제안 (검증 통과분만)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
