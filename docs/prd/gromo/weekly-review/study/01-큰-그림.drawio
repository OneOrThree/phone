  <diagram id="page2-timeline" name="한 주의 타임라인">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="월 ~ 일&#10;세션 기록이 매일 쌓임&#10;(기존 기능, 손댈 것 없음)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="다음주 월 08:00&#10;배치 실행:&#10;집계 → 채점 → LLM → 저장 → 푸시" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="120" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="월요일 낮 (아무 때나)&#10;사용자가 푸시를 눌러 열람&#10;— 이미 완성돼 있어 즉시 뜸" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="120" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="te1" value="주 경계 = KST [월 00:00, 다음 월 00:00)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" edge="1" parent="1" source="t1" target="t2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te2" value="푸시 → 딥링크" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" edge="1" parent="1" source="t2" target="t3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tn1" value="08:00인 이유: 일요일 밤 늦게 끝난 세션이 들어올 여유(보장은 아님 — 늦은 업로드 정책은 prd.md).&#10;열람 시점에 LLM을 부르지 않는 이유는 1편 본문 참고 (속도·비용·일관성·실패 격리)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="250" width="760" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
