# GROMO dev docker-compose 환경변수 예시 — 복사: cp .env.example .env
# docker-compose.dev.yml + docker-compose.observability.yml(GROMO-546) 공용. .env 는 gitignore 됨.

# --- DB (dev app + postgres-exporter 공용) ---
POSTGRES_DB=gromo
POSTGRES_USER=gromo
POSTGRES_PASSWORD=change-me

# --- 앱 시크릿 (실제 dev 는 AWS Secrets Manager 주입) ---
JWT_SECRET=change-me-at-least-256-bits-long-padded-for-hmac-sha256
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
# FCM (dev 프로파일 = 발송 활성, 미설정 시 fail-fast 기동 실패) — GROMO-528
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# --- 관측 스택 (GROMO-546) — Grafana 로그인 ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
