  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "① 일반 로그 — 서비스 · 시간 · level",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "logs",
      "title": "① 일반 로그",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 18,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{env=~\"$env\", service=~\"$service\"} | json | level=~\"$level\"",
          "queryType": "range",
          "maxLines": 1000
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "① 범위 안 줄 수 (빨강 = 왼쪽은 일부)",
      "description": "패널 줄 상한은 1000줄이다(maxLines). 이 값이 1000 이상(빨강)이면 옆 표는 결과 «일부»다 — ⑤ 를 따른다.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({env=~\"$env\", service=~\"$service\"} | json | level=~\"$level\" | keep service [$__range]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "② 원인 키 — 요청 번호 · 원인 trace · event_id · message_id (입력한 키의 합집합, 시간순)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "table",
      "title": "② 원인 키로 찾은 로그",
      "description": "같은 log_id 가 두 줄이면 수집 재전송 사본이다(Loki 는 지우지 않는다). operation_id 를 누르면 ④ 로, dd_trace_id 는 Datadog APM 으로, Time 은 같은 시각 지표로 간다.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 18,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{env=~\"$env\", service=~\"$service\"} | json | (request_id!=\"\" and request_id=\"$request_id\") or (origin_request_id!=\"\" and origin_request_id=\"$request_id\") or (origin_trace_id!=\"\" and origin_trace_id=\"$origin\") or (dd_trace_id!=\"\" and dd_trace_id=\"$origin\") or (trace_id!=\"\" and trace_id=\"$origin\") or (event_id!=\"\" and event_id=\"$event_id\") or (message_id!=\"\" and message_id=\"$message_id\")",
          "queryType": "range",
          "maxLines": 1000
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "auto",
            "replace": false,
            "keepTime": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "labels": true,
              "Line": true,
              "tsNs": true,
              "labelTypes": true,
              "id": true,
              "env": true,
              "log_kind": true,
              "schema_version": true,
              "version": true,
              "logger": true,
              "dd_span_id": true,
              "span_id": true,
              "legacy_trace_id": true,
              "stream": true,
              "truncated": true,
              "original_size_bytes": true,
              "exception": true
            },
            "indexByName": {
              "Time": 0,
              "service": 1,
              "level": 2,
              "event_name": 3,
              "request_id": 4,
              "origin_request_id": 5,
              "origin_trace_id": 6,
              "dd_trace_id": 7,
              "event_id": 8,
              "delivery_id": 9,
              "attempt": 10,
              "operation_id": 11,
              "message_id": 12,
              "message": 13,
              "log_id": 14,
              "observed_at": 15,
              "instance_id": 16,
              "thread": 17
            },
            "renameByName": {}
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Time",
                "desc": false
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "dd_trace_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Datadog APM trace",
                    "url": "https://${dd_site}/apm/trace/${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "같은 시각 ±5분 지표 (gromo-overview)",
                    "url": "/d/gromo-overview/?orgId=1&time=${__value.time}&time.window=600000"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "operation_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "이 operation 의 결과 보기 (④)",
                    "url": "/d/log-investigation/?orgId=1&${__url_time_range}&${env:queryparam}&${service:queryparam}&${level:queryparam}&${request_id:queryparam}&${origin:queryparam}&${event_id:queryparam}&${message_id:queryparam}&${dd_site:queryparam}&var-operation_id=${__value.raw}&var-delivery_id=${__data.fields.delivery_id}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "count"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "② 결과 줄 수 (빨강 = 왼쪽은 일부)",
      "description": "패널 줄 상한은 1000줄이다(maxLines). 이 값이 1000 이상(빨강)이면 옆 표는 결과 «일부»다 — ⑤ 를 따른다.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 6,
        "x": 18,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({env=~\"$env\", service=~\"$service\"} | json | (request_id!=\"\" and request_id=\"$request_id\") or (origin_request_id!=\"\" and origin_request_id=\"$request_id\") or (origin_trace_id!=\"\" and origin_trace_id=\"$origin\") or (dd_trace_id!=\"\" and dd_trace_id=\"$origin\") or (trace_id!=\"\" and trace_id=\"$origin\") or (event_id!=\"\" and event_id=\"$event_id\") or (message_id!=\"\" and message_id=\"$message_id\") | keep service [$__range]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 102,
      "type": "row",
      "title": "③ operation.link → operation_id (기기별 발송 한 번)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "table",
      "title": "③ ② 의 원인에 연결된 operation (operation_id 를 누르면 ④)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Notification 이 기기별 전송마다 구성원(전달 행)마다 남긴 operation.link. 같은 operation_id 에 다른 원인의 구성원이 있으면 ④ 에 함께 보인다(공유 발송).",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (operation_id, delivery_id, event_id, origin_request_id, attempt) (count_over_time({env=~\"$env\", service=\"notification\"} | json | event_name=\"operation.link\" | (request_id!=\"\" and request_id=\"$request_id\") or (origin_request_id!=\"\" and origin_request_id=\"$request_id\") or (origin_trace_id!=\"\" and origin_trace_id=\"$origin\") or (dd_trace_id!=\"\" and dd_trace_id=\"$origin\") or (trace_id!=\"\" and trace_id=\"$origin\") or (event_id!=\"\" and event_id=\"$event_id\") or (message_id!=\"\" and message_id=\"$message_id\") | keep operation_id, delivery_id, event_id, origin_request_id, attempt [$__range]))",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "operation_id": 0,
              "delivery_id": 1,
              "event_id": 2,
              "origin_request_id": 3,
              "attempt": 4
            },
            "renameByName": {
              "Value": "연결 로그 수"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "operation_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "이 operation 의 결과 보기 (④)",
                    "url": "/d/log-investigation/?orgId=1&${__url_time_range}&${env:queryparam}&${service:queryparam}&${level:queryparam}&${request_id:queryparam}&${origin:queryparam}&${event_id:queryparam}&${message_id:queryparam}&${dd_site:queryparam}&var-operation_id=${__value.raw}&var-delivery_id=${__data.fields.delivery_id}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "count"
          ]
        }
      }
    },
    {
      "id": 103,
