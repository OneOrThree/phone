// Use DBML to define your database structure
// Docs: https://dbml.dbdiagram.io/docs
// Project: Gromo — ERD v10 (UUID PK 전환)
// 섹션 순서: 1.유저 → 2.챌린지 → 3.포커스 → 4.그룹 → 5.아이템 → 6.리그 → 7.재화 → 8.LLM/집계
// Flyway 반영: V1__baseline ~ V30 (src/main/resources/db/migration). 스키마 변경 시 V<N> SQL 추가와 함께 이 파일 갱신.
// V30 은 데이터 백필 전용(스키마 무변경) — 탈퇴 유저 유령 멤버십 leave 처리 + 유령뿐인 그룹 ENDED (GROMO-1220).

// ────────────────────────────────────────────
// Enums (도메인별 — 테이블 섹션과 동일 순서)
// ────────────────────────────────────────────

// 1. 유저 / 인증
Enum occupation {            // 유저 직업/신분 (code=영문, 표시명은 occupations.display_name — GROMO-631)
  LABOR_ATTORNEY            // 노무사
  PATENT_ATTORNEY           // 변리사
  TAX_ACCOUNTANT            // 세무사
  CPA                       // 회계사
  APPRAISER                 // 감정평가사
  CIVIL_SERVANT             // 공무원
  POLICE_FIRE               // 경찰소방
  ADMIN_EXAM                // 행정고시
  CERTIFICATION             // 자격증
  MIDDLE_SCHOOL             // 중학생
  HIGH_SCHOOL               // 고등학생
  CSAT                      // 수능/N수
  UNIVERSITY                // 대학생
  JOB_PREP                  // 취업 준비
  ENGLISH_TEST              // 토익/토플
  CODING                    // 코딩
  SELF_DEVELOPMENT          // 자기계발
  FOCUS_BUILDING            // 집중력 키우기
  ETC                       // 기타
}

Enum stat_visibility {       // 통계 공개 범위
    FRIENDS                    // 친구공개 (friendships ACCEPTED 한정)
    PUBLIC                     // 전체공개
}

Enum provider {              // 소셜 로그인 제공자
  APPLE
  GOOGLE
  KAKAO
  LINE
  INSTAGRAM
  FACEBOOK
}

Enum friendship_status {     // 친구 관계 상태 (요청 → 수락/거절)
  PENDING
  ACCEPTED
  REJECTED
}

// 2. 챌린지
Enum challenge_category {     // 미션 분류
  FOCUS
  SCREEN_TIME
}

Enum challenge_type {         // 미션 방식
  TIME_WINDOW                // 지정 시간대 내 수행
  DURATION                   // 누적 시간 달성
}

Enum challenge_status {       // 챌린지 수명주기 (policy §A8) — V2 의 INACTIVE 를 V34 가 ENDED 로 복원
  ACTIVE
  ENDED
}

// 3. 포커스
Enum focus_type {
  INFINITE                  // 카운트업 / 무제한 (구 UP)
  RANGE                     // 목표시간 카운트다운 (구 DOWN)
  POMODORO
}

Enum focus_session_status {  // 세션 생명주기 (deleted_at 대체 — 소거 대상 데이터를 딜리트 마커로 쌓지 않음)
  ACTIVE                    // 진행중(라이브) — ended_at IS NULL
  COMPLETED                 // 정상 종료
  CANCELED                  // 유저 취소/폐기
  AUTO_CLOSED               // orphan 자동 종료(sweepOrphanSessions) — by-category 실시간 집계에서 제외 (GROMO-804, V9)
}

// 4. 그룹
Enum group_status {           // 그룹 진행 상태
  WAITING
  ACTIVE
  ENDED
}

Enum group_member_role {      // 멤버 역할
  OWNER
  MEMBER
}

Enum group_member_status {    // 멤버 활동 상태 (챌린지/포커스 진행)
  INACTIVE
  CHALLENGE
  FOCUS
}

Enum group_permission_scope { // 그룹 단위 권한 범위 (초대 등)
  OWNER_ONLY
  ALL_MEMBERS
}

Enum group_announcement_grant { // 멤버 단위 공지 작성 권한 (개별 허용/차단)
  DISALLOW
  ALLOW
}

Enum code_status {            // 참가 코드 상태
  ACTIVE
  ENDED
}

Enum group_invite_status {    // 그룹 초대 상태 (미사용 — 초대 테이블 미구현)
  PENDING
  ACCEPTED
  DECLINED
}

// 5. 아이템 / 캐릭터
Enum item_type {              // 아이템 종류
  EQUIPPABLE
  DECORATIVE
}

Enum slot_type {              // 장착 슬롯
  HAIR
  TOP
  BOTTOM
  SHOES
}

Enum payment_type {           // 결제 수단 정책 (구 price_type)
  CURRENCY                   // 인게임 재화만
  PREMIUM                    // 현질 재화만
  BOTH                       // 둘 다 가능
}

// 6. 리그
// 리그 티어는 enum이 아니라 정수 레벨(tier_level 1~5)로 저장 — 표시명(초콜릿 등)은 앱에서 레벨→이름 매핑

Enum league_arena_status {    // 리그 아레나 상태
  ACTIVE
  ENDED
}

Enum league_weekly_result {   // 주간 정산 결과 (league_weekly_results.result, 티어 임계값 기반). 구 league_member_result(순위 구간·RELEGATE_WARNING 포함)는 아레나 순위제 폐지(GROMO-817, V14)로 제거
  PROMOTED                    // 승급 (지난주 누적 ≥ promotion_time)
  STAY                        // 유지
  RELEGATED                   // 강등 (지난주 누적 < relegation_time)
}

// 7. 재화 / 보상
Enum currency_type {          // 재화 변동 유형 (구 currency_reason)
  SESSION_COMPLETE
  STREAK_BONUS
  PURCHASE
  BET_STAKE                   // 그룹 챌린지 내기 판돈 차감(에스크로) — 서버 주도
  BET_PAYOUT                  // 내기 정산 승자 분배금 지급 — 서버 주도
  BET_REFUND                  // 승자 0명 내기의 전원 환불 — 서버 주도
}

Enum group_bet_status {       // 그룹 챌린지 내기 회차 상태 (group_challenge_bet_sessions.status — V39 2계층 재편)
  OPEN                        // 참가 가능. 정산 배치가 훑는 유일한 상태
  SETTLED                     // 정산 완료 — 승자에게 분배
  REFUNDED                    // 전원 환불로 종료 (구 승자 0명 환불 이력 + 24h 데드라인 자동 환불 N21 — 사유는 void_reason)
  FORFEITED                   // 승자 0명 → 전액 몰수·소멸 (V20)
  VOIDED                      // 무산 — 환불 대상이 실제 1명 있는 경우 한정(N33·N52). 사유는 void_reason. V41
  UNUSED                      // 참가자 0명 전용 종료(N52) — 결과·내역·알림 제외. V41. 구 CANCELED 는 V39 에서 소멸(행 삭제 = "없던 일")
}

Enum group_bet_void_reason {  // 회차 무산·환불 사유 (V41, GROMO-1404)
  INSUFFICIENT_PARTICIPANTS   // 참가 마감 시점 인원 미달(2명 미만) — 참가 마감 크론(N47)
  CHALLENGE_DELETED           // 그룹장 챌린지 삭제로 무효화·환불
  REFUND_DEADLINE             // 정산 24h 데드라인 초과 자동 전원 환불(N21)
}

// 기타 (미사용 — 테이블/기능 미구현)
Enum bet_type {               // 내기 방식 (미사용 — 사용 컬럼 없음, 예정 기능)
  CASH
  CURRENCY
  NONE
}

// ────────────────────────────────────────────
// 0. 직업 / 세팅
// ────────────────────────────────────────────

Table occupations [note: 'occupation 마스터(하이브리드, GROMO-626). Enum occupation 은 유지하고 표시명·정렬을 얹은 마스터. code=Enum occupation name. users.occupation·occupation_default_tags.occupation 이 code 를 FK 참조. migration v27'] {
  code         varchar(64)  [pk, note: 'Enum occupation name (MIDDLE_SCHOOL 등)']
  display_name varchar(255) [not null, note: '표시명 (앱 하드코딩 → 서버 소스오브트루스)']

  created_at   timestamptz  [not null, default: `now()`, note: '생성 시각']
  deleted_at   timestamptz  [note: '소프트 딜리트 (시드 교체 여지)']
}

Table default_tags [note: '글로벌 태그 마스터 (공부 과목 시드 + 유저 생성). 인덱싱/재사용 단위'] {
  id         uuid         [pk]

  name       varchar(255) [not null, unique, note: '태그명 (공부 과목 등) — 검색/인덱스 키. 추후 pg_trgm GIN 검토']

  created_at timestamptz  [not null, default: `now()`, note: '생성 시각']
}

Table occupation_default_tags [note: 'occupation ⇄ default_tags 교차(N:N) — occupation별 추천 태그 매핑. 온보딩/태그설정에서 노출, 선택 시 user_focus_tags 로 등록 (GROMO-607)'] {
  id              uuid        [pk]

  occupation      occupation  [not null, note: 'Enum occupation 재사용 (occupations.code FK)']
  default_tag_id uuid        [not null, note: 'FK → default_tags.id (GROMO-673: name 대체)']

  sort_order      integer     [not null, note: '노출 정렬 순서(추천 목록 오름차순)']

  created_at      timestamptz [not null, default: `now()`, note: '생성 시각']

  indexes {
    (occupation, default_tag_id) [unique, note: '중복 시드 방지']
  }
}

// ────────────────────────────────────────────
// 1. 유저 / 인증
// ────────────────────────────────────────────

Table users [note: '서비스 사용자 계정 (소셜 로그인 기반, 소프트 딜리트)'] {
  id                             uuid        [pk]
  is_guest                       boolean     [not null, default: false, note: '게스트 계정 여부']

  nickname                       varchar(255) [note: '표시 닉네임']
  country_code                   varchar(2)  [note: 'ISO 3166-1 alpha-2 (예: KR, US)']

  occupation                     occupation  [note: '유저 직업/신분 (온보딩에서 수집, 가입 시 null)']

  stat_visibility                stat_visibility [not null, note: '유저의 개인통계 공개 여부']

  refresh_token_hash             varchar(512) [note: 'JWT 리프레시 토큰의 SHA-256 해시 (인증) — 평문 저장 금지 GROMO-713']

  device_token                   varchar(512) [note: 'FCM registration token (서버 푸시 공용 — 리그·미접속 등). GROMO-528']

  last_active_at                 timestamptz [not null, default: `now()`, note: '마지막 활동 시각 — 미접속 복귀 푸시(GROMO-578) D+3/7/14 판정. JwtFilter 가 하루 1회 스로틀 갱신. migration v25. 부분 인덱스 idx_users_last_active_at (last_active_at) WHERE is_guest=false AND is_deleted=false — 배치 풀스캔 방지']

  character_trial_anchor_at      timestamptz [note: '누끼 생성 trial(7일 무제한) 기준 시각 — 유저가 쿼터를 처음 조회할 때 1회 박힘. 배포일 상수 대신 유저별 첫 접촉을 쓰는 이유는 앱 업데이트 시점이 유저마다 달라도 trial 7일을 온전히 주기 위함. NULL = 아직 기능 미접촉. migration v26']

  created_at                     timestamptz [not null, default: `now()`, note: '가입 시각']
  updated_at                     timestamptz
  is_deleted                     boolean [not null, default: false, note: '회원탈퇴 삭제 대기 플래그 — 동의 보관기간 경과 후 배치 하드 삭제(retention→purge)']

  tier_level                     integer     [not null, default: 1, note: '리그 티어 레벨 1~5 단일 원천(SoT) — CHECK BETWEEN 1 AND 5. 구 current_tier(V2 드롭) 대체. GROMO-814, V12']

  is_bot                         boolean [not null, default: false, note: '리그 콜드스타트용 스크립트 유저 여부. 리그 랭킹·친구 검색에는 실유저와 동일하게 노출되고, 실유저 통계 분리·봇 회수 시 대상 특정에만 쓴다. 성향은 bot_profiles. GROMO-1565, V48']

  indexes {
    // GROMO-460: 친구 닉네임 fuzzy 검색용 GIN 트라이그램 인덱스 (run-migration-v13.sh)
    //   전제 확장: CREATE EXTENSION pg_trgm  /  쿼리: nickname % :q ORDER BY nickname <-> :q
    nickname [type: gin, note: 'pg_trgm GIN (gin_trgm_ops) — 닉네임 trgm 검색 GROMO-460']
    occupation [name: 'idx_users_occupation', note: 'CATEGORY 평균 집중 집계가 occupation=? 로 모수 좁힐 때 사용 GROMO-753, V11']
    is_bot [name: 'idx_users_is_bot', note: '부분 인덱스 WHERE is_bot = true — BotSimulator 가 매 tick 봇 목록을 뽑는다. GROMO-1565, V48']
  }
}

Table user_focus_time_settings [note: '유저별 포커스 타임 목표 설정 (users 1:1)'] {
  user_id                        uuid       [pk, note: 'FK → users.id (1:1)']

  daily_focus_time_goal_minutes integer     [not null, default: 0, note: '포커스 목표(분 이상)']

  previous_goal_minutes          integer     [note: '직전 목표(분) — 오늘 첫 변경 직전 값 = 어제 유효했던 목표 (GROMO-1049)']
  goal_effective_from            date        [note: '현재 목표 발효일(유저 로컬). 이 날짜 이전 날은 previous 를 쓴다']

  updated_at                     timestamptz
  deleted_at                     timestamptz [note: '탈퇴 시각 (소프트 딜리트 감사 로그용)']
}

Table user_screen_time_settings [note: '유저별 스크린타임 권한·목표 설정 (users 1:1)'] {
  user_id                        uuid       [pk, note: 'FK → users.id (1:1)']

  is_screen_time_permission_granted boolean  [not null, default: false, note: 'iOS 스크린타임 권한 동의 여부']
  daily_screen_time_goal_minutes integer     [not null, default: 0, note: '스크린타임 목표(분 이내)']

  previous_goal_minutes          integer     [note: '직전 목표(분) — 오늘 첫 변경 직전 값 = 어제 유효했던 목표 (GROMO-1049)']
  goal_effective_from            date        [note: '현재 목표 발효일(유저 로컬). 이 날짜 이전 날은 previous 를 쓴다']

  updated_at                     timestamptz
  deleted_at                     timestamptz [note: '탈퇴 시각 (소프트 딜리트 감사 로그용)']
}

Table user_notification_settings [note: '유저별 알림 설정 (users 1:1)'] {
  user_id                        uuid       [pk, note: 'FK → users.id (1:1)']

  notification_enabled           boolean     [not null, default: true,  note: '전역 알림 on/off']

  sound_enabled                  boolean     [not null, default: true,  note: '알림 소리 on/off']

  night_mode_enabled             boolean     [not null, default: false, note: '심야 모드 on/off']

  night_start_time               time        [note: '심야 모드 시작 시각']
  night_end_time                 time        [note: '심야 모드 종료 시각']

  updated_at                     timestamptz
  deleted_at                     timestamptz [note: '탈퇴 시각 (소프트 딜리트 감사 로그용)']
}

Table user_wallets [note: '유저 재화 잔액 (users 1:1). GROMO-561 로 user_wallet → user_wallets 리네임'] {
  user_id    uuid    [pk, note: 'FK → users.id (1:1)']
  balance    integer [not null, default: 0, note: '재화 잔액']
  updated_at timestamptz
  deleted_at timestamptz [note: '탈퇴 시각 (소프트 딜리트) — 재화 이력 보존, 하드 삭제 금지']
}

Table bot_profiles [note: '리그 콜드스타트용 봇 유저의 집중 성향 (users 1:1, is_bot=true 인 행만 존재). GROMO-1565, V48'] {
  user_id        uuid    [pk, note: 'FK → users.id (1:1)']
  chronotype     varchar(20) [not null, note: '활동 시간대 — DAWN(04~) / MORNING(08~) / AFTERNOON(13~) / NIGHT(20~, 자정 넘겨 최대 다음날 06시). CHECK 4값']
  style          varchar(20) [not null, note: '집중 스타일 — POMODORO(25~50분) / MIXED(45~75분) / DEEP(70~110분). CHECK 3값. 어떤 스타일도 블록이 110분을 넘지 않는다']
  weekly_minutes integer [not null, note: '주간 목표 집중 분 — 티어 유지 구간(14/28/42/56시간) 안쪽에 둔다. CHECK 60~4200']
  active_days    integer [not null, note: '주 며칠 집중하는가 (4~6). CHECK 1~7']
  rest_day_mask  integer [not null, note: '쉬는 요일 비트마스크 — 비트 0=월 … 비트 6=일. CHECK 0~127']
  created_at     timestamptz [not null, default: `now()`]
}

Table social_accounts [note: '소셜 로그인 연동 정보 (provider + provider_id 조합으로 유저 식별)'] {
  id          uuid        [pk]
  user_id     uuid        [not null, note: 'FK → users.id']

  provider    provider    [not null, note: 'APPLE / GOOGLE / KAKAO / LINE / INSTAGRAM / FACEBOOK']
  provider_id varchar(255) [not null, note: '소셜 제공자 측 사용자 식별자']

  created_at  timestamptz [not null, default: `now()`, note: '연동 시각 — 어떤 소셜로 처음 가입했는지 추적(최초 provider 식별)']
  deleted_at  timestamptz [note: '연동 해제 시각 (소프트 딜리트)']

  indexes {
    (provider, provider_id) [unique, note: '외부 신원 식별키 — provider_id는 제공자 네임스페이스 내에서만 유일하므로 복합 unique']
  }
}

Table friendships [note: '유저 간 친구 관계 (요청 → 수락/거절). from_user가 to_user에게 신청'] {
  id           uuid              [pk]

  from_user_id uuid              [not null, note: '친구 신청한 유저 (FK → users.id)']
  to_user_id   uuid              [not null, note: '신청 받은 유저 (FK → users.id)']

  status       friendship_status [not null, default: 'PENDING', note: 'PENDING / ACCEPTED / REJECTED']

  created_at   timestamptz       [not null, default: `now()`, note: '신청 시각']
  updated_at   timestamptz       [note: '상태 변경(수락/거절) 시각']
  deleted_at   timestamptz       [note: '친구 삭제 시각 (소프트 딜리트)']

  indexes {
    // 재친구 허용: 소프트 딜리트(deleted_at) 행이 남아 단순 unique 불가. 활성 관계만 1개 보장하는 부분 unique는 마이그레이션에서:
    //   CREATE UNIQUE INDEX ... ON friendships (from_user_id, to_user_id) WHERE deleted_at IS NULL;
    (from_user_id, to_user_id) [note: '활성 관계 부분 unique(WHERE deleted_at IS NULL)는 마이그레이션 SQL로 적용 — 동일 방향 중복 신청 차단. 양방향(A→B / B→A) 중복은 앱/마이그레이션에서 정규화 처리']
  }
}

Table user_blocks [note: '유저 차단 (방향성: blocker가 blocked를 차단). 친구관계와 독립'] {
  id         uuid        [pk]

  blocker_id uuid        [not null, note: '차단한 유저 (FK → users.id)']
  blocked_id uuid        [not null, note: '차단당한 유저 (FK → users.id)']

  created_at timestamptz [not null, default: `now()`, note: '차단 시각']

  indexes {
    (blocker_id, blocked_id) [unique, note: '중복 차단 방지']
  }
}

Table pinned_users [note: '친구 핀 (방향성: user_id가 friend_user_id를 핀). 홈·집중 화면 동반 표시 (GROMO-454). GROMO-561 로 pinned_friend → pinned_friends 리네임'] {
  id             uuid        [pk]

  user_id        uuid        [not null, note: '핀한 유저 (FK → users.id)']
  pinned_user_id uuid        [not null, note: '핀된 친구 (FK → users.id)']

  created_at     timestamptz [not null, default: `now()`, note: '핀 시각']

  indexes {
    (user_id, pinned_user_id) [unique, note: '같은 친구 중복 핀 차단 (멱등)']
  }
}

// ────────────────────────────────────────────
// 2. 챌린지
// ────────────────────────────────────────────

Table group_challenges [note: '그룹 챌린지 (집중/스크린타임 미션). type 별 파라미터는 상세 테이블로 분리 — TIME_WINDOW→group_challenge_windows, DURATION→group_challenge_durations'] {
  id                 uuid               [pk]
  group_id           uuid               [not null, note: 'FK → groups.id']

  type             challenge_type     [not null, note: 'TIME_WINDOW / DURATION — 방식에 따라 상세 테이블 1:1']
  category         challenge_category [not null, note: 'FOCUS / SCREEN_TIME']

  status             challenge_status   [not null, default: 'ACTIVE', note: 'ACTIVE / ENDED — 수명주기(policy §A8). V2 의 INACTIVE 를 V34 가 ENDED 로 복원. 서버에서만 전환 (유저 수정 불가)']

  repeat_days        integer            [not null, note: '도는 요일 비트마스크(§A3) — ISO 요일(월=1…일=7)을 1<<(dow-1) 로 접음: 월=1…일=64, 매일=127. CHECK 1 ≤ x ≤ 127 (요일 하나는 반드시). 기존 행 백필=127. V34 추가(smallint), V46 integer 확장']
  started_at         timestamptz        [not null, note: '활동 시작 시각 — 생성 즉시 돌기 시작(기존 행 백필=created_at). migration V34']
  ended_at           timestamptz        [note: '종료(ENDED 전이) 시각 — null 이면 진행 중. 레거시 INACTIVE→ENDED 행은 created_at 근사 백필. migration V34']

  created_at         timestamptz        [not null, default: `now()`]
  deleted_at         timestamptz        [note: '삭제 시각 (소프트 딜리트). 콘텐츠 수정 불가 → 수정은 삭제 후 새 row, 옛 내용 보존']

  indexes {
    (group_id, category) [unique, name: 'uq_group_challenges_active_duration_category', note: "부분 유니크(WHERE type = 'DURATION' AND status = 'ACTIVE' AND deleted_at IS NULL) — 하루형만 카테고리당 활성 1개(FR-3), 창형은 겹침 검사(서비스)만 통과하면 복수 허용. V20 의 (group_id, category, type) 활성 유니크를 V36 이 완화"]
    (id, category) [unique, name: 'uq_group_challenges_id_category', note: '자식 복합 FK(group_challenge_durations)의 참조 대상 — 부분 인덱스 아님. migration V36']
    group_id [name: 'idx_group_challenges_active_group', note: '부분 인덱스(WHERE status = ACTIVE AND deleted_at IS NULL) — 활성 목록·그룹당 활성 4개 상한(FR-1) 검사. migration V36']
  }
}

Table group_challenge_durations [note: 'DURATION 챌린지 상세 (group_challenges 1:1, type=DURATION 만). 타입별 필드 분리(CTI)로 NULL 오염 방지'] {
  challenge_id     uuid               [pk, note: 'FK → group_challenges.id (1:1). type=DURATION 챌린지만']
  category         challenge_category [not null, note: '부모 category 비정규화 복사(V36) — 복합 FK (challenge_id, category) → group_challenges (id, category) 가 부모와의 일치를 보증. 카테고리별 상한 CHECK 를 걸기 위한 컬럼']
  duration_minutes integer            [not null, note: '하루 목표 시간(분). CHECK 카테고리별 상한(N51 · §A6-bis): FOCUS 1~1080(18h) · SCREEN_TIME 1~720(12h) — V28 의 단일 1~1440 을 V36 이 교체']
}

Table group_challenge_windows [note: 'TIME_WINDOW 챌린지 상세 (group_challenges 1:1, type=TIME_WINDOW 만). 타입별 필드 분리(CTI)로 NULL 오염 방지. 창은 요일 반복 시간대(repeat_days) — 시각은 KST 벽시계 time 타입(V35)'] {
  challenge_id     uuid        [pk, note: 'FK → group_challenges.id (1:1). type=TIME_WINDOW 챌린지만']
  window_start     time        [not null, note: '수행 지정 시간대 시작 — KST 벽시계 시각 그 자체(time, V35 · GROMO-1406). 종전 timestamptz 의 EPOCH 앵커 해석 규약은 타입 승격으로 폐기']
  window_end       time        [not null, note: '수행 지정 시간대 종료 — CHECK window_start < window_end (자정 걸침 금지 §A6-1 · N25: 회차가 요일 경계를 넘지 않는다). migration V35']
  duration_minutes integer     [note: '창 내 목표 시간(분), 0 < x ≤ 창 길이. null 이면 판정불가(내기 개설 불가) — 목표분 없는 기존 창 챌린지. migration V20']
}

Table group_challenge_members [note: '스크린타임 창(TIME_WINDOW×SCREEN_TIME) 사용분의 날짜별 유저 보고 저장 (V1 이후 미사용이던 테이블을 V20 에서 usage_date 추가로 재활용 — 클라 신뢰 upsert. V43 부터 measured_at 단조 갱신: 저장값보다 오래된 보고는 조용히 무시, GROMO-1407·N34)'] {
  id                 uuid        [pk]
  group_challenge_id uuid        [not null, note: 'FK → group_challenges.id']
  user_id            uuid        [not null, note: 'FK → users.id']
  usage_date         date        [not null, note: '보고 대상 날짜(KST). V37 에서 NOT NULL 승격(GROMO-1266) — NULL 잔재 행은 삭제로 정리. migration V20·V37']

  progress_minutes   integer     [not null, default: 0, note: '해당 날짜 창 내 사용분(분) 보고값. 판정(달성)은 저장하지 않고 조회 시 계산 — 구 is_achieved·achieved_at 은 V37 에서 드롭(GROMO-1265)']
  measured_at        timestamptz [note: '클라 측정 시각 — 역전 보고 방어의 비교 축(V43, N34). null = 도입 전 레거시 행("시각 모름" — 어떤 보고든 갱신 허용). 미래(+2분 초과)는 API 가 400 거절']

  created_at         timestamptz [not null, default: `now()`]
  updated_at         timestamptz
  deleted_at         timestamptz [note: '삭제 시각 (소프트 딜리트)']

  indexes {
    (group_challenge_id, user_id, usage_date) [unique, name: 'uq_group_challenge_members_challenge_user_date', note: '유저·챌린지·날짜당 보고 1행 (V20 에서 (challenge, user) 유니크를 교체)']
  }
}

Table group_challenge_bets [note: '그룹 챌린지 내기 설정 — 챌린지 1:1 (V39 2계층 재편, GROMO-1262). "개설" 행위 소멸: 판(참가·판정·정산 단위)은 group_challenge_bet_sessions(회차)다. migration V19·V39·V40'] {
  id              uuid             [pk]

  group_id        uuid             [not null, note: 'FK → groups.id (조회 시 그룹 스코프 검증용 비정규화)']
  challenge_id    uuid             [not null, unique, note: 'FK → group_challenges.id — 챌린지당 설정 1개 (uq_group_challenge_bets_challenge)']

  stake           integer          [not null, note: '1인 참가비. CHECK 1~3000 (V40, N30). 회차 개설 시점에 회차로 박제되므로 변경이 과거 회차를 흔들지 않는다']
  enabled         boolean          [not null, default: true, note: '내기 켜짐 — 생성 시 결정, 이후 불변(끄려면 챌린지 삭제 후 재생성 — policy §A7·N26). V39']

  created_at      timestamptz      [not null, default: `now()`]
  updated_at      timestamptz      [not null]
}

Table group_challenge_bet_sessions [note: '내기 회차 — 챌린지가 실제 도는 하루(V39, GROMO-1262). 참가·판정·정산의 단위. 미션 스냅샷(카테고리·방식·목표분·창 시각·참가비)을 박제해 챌린지가 삭제돼도 내역 한 줄이 조인 없이 온전하다(GROMO-1263, N6-1). migration V39·V40·V41'] {
  id              uuid             [pk, note: 'V39 백필은 구 내기 행 id 를 재사용 — 참가 행·원장 멱등키·알림 dedup 의 대상 id 가 안 흔들린다']

  bet_id          uuid             [not null, note: 'FK → group_challenge_bets.id — 설정']
  group_id        uuid             [not null, note: 'FK → groups.id — 내역이 그룹 소유라 비정규화']
  challenge_id    uuid             [not null, note: 'FK → group_challenges.id — 소프트 삭제라 삭제 뒤에도 유효']

  session_date    date             [not null, note: '회차 날짜(KST)']
  stake           integer          [not null, note: '개설 시점 박제 참가비. CHECK 1~3000 (V40)']
  goal_minutes    integer          [note: '개설 시점 박제 목표 분(스냅샷). null = V39 백필 이전(V29 미만) 정산 이력 — 앱 "—" 표시']
  mission_category varchar(20)     [not null, note: '미션 스냅샷 — FOCUS / SCREEN_TIME']
  mission_type    varchar(20)      [not null, note: '미션 스냅샷 — DURATION / TIME_WINDOW']
  window_start    time             [note: '미션 스냅샷 — 창 시작(KST 벽시계, 창형만)']
  window_end      time             [note: '미션 스냅샷 — 창 종료(KST 벽시계, 창형만)']

  status          group_bet_status [not null, note: 'OPEN / SETTLED / REFUNDED / FORFEITED / VOIDED / UNUSED(V41)']
  void_reason     group_bet_void_reason [note: 'VOIDED·24h 환불 사유(V41, N33·N52). 그 외 null']

  starts_at       timestamptz      [not null, note: '회차 시작 — 참가 취소(시작 전) 기준. 하루형 00:00 KST · 창형 창 시작']
  join_closes_at  timestamptz      [not null, note: '참가 마감(LLD §1.1) — 창형 창 시작 · 하루형 회차 종료. 강제는 신 참여 API(B4)']
  closes_at       timestamptz      [not null, note: '회차 종료']
  settle_after    timestamptz      [not null, note: '정산 가능 시각 — 창형 종료+30분(N12) · 하루형 FOCUS +1h · SCREEN_TIME +12h']
  settled_at      timestamptz      [note: '정산(종료 전이) 시각. OPEN 이면 null']
  settle_attempts integer          [not null, default: 0, note: '정산 재시도 횟수(백오프 — B4 배선)']
  next_attempt_at timestamptz      [note: '다음 재시도 시각(백오프 — B4 배선). null = 즉시']

  created_at      timestamptz      [not null, default: `now()`]
  updated_at      timestamptz      [not null]

  indexes {
    (bet_id, session_date) [unique, name: 'uq_group_challenge_bet_sessions_bet_date', note: '하루 1회차 — 구 (챌린지,날짜) 부분 유니크(FR-7)는 V39 에서 폐기']
    (status, settle_after, next_attempt_at) [name: 'idx_group_challenge_bet_sessions_settle_scan', note: '정산 대상 스캔(백오프 포함)']
    (group_id, session_date) [name: 'idx_group_challenge_bet_sessions_group_date', note: '카드·그룹 내역 조립']
    challenge_id [name: 'idx_group_challenge_bet_sessions_challenge_id', note: '히스토리·삭제 가드·휴면 배지']
  }
}

Table group_challenge_bet_participants [note: '내기 회차 참가자(V39 — 축이 내기 행에서 회차로 이동). 참가비는 참가 즉시 차감(에스크로)되고 achieved/payout/progress_minutes 는 정산 시 기록된다. 이 행의 id 가 돈 흐름 멱등키의 단일 축(FR-42). migration V19·V29·V39·V42·V49'] {
  id         uuid        [pk]

  session_id uuid        [not null, note: 'FK → group_challenge_bet_sessions.id (구 bet_id 를 V39 에서 리네임 — 값 보존)']
  user_id    uuid        [not null, note: 'FK → users.id']

  achieved   boolean     [note: '정산 시 기록 — 판정 결과. 정산 전이면 null. 승리는 조기 확정 가능(GROMO-1268, 불가역)']
  achieved_at timestamptz [note: '조기 확정 시각(V42, LLD §1.1) — confirmWin 순간 박제. 조기 확정 전용이라 정산 시점 판정은 null(회차 settled_at 이 시각 축)']
  payout     integer     [note: '정산 시 기록 — 승자 분배금(패자 0) 또는 환불금. 정산 전이면 null']
  progress_minutes integer [note: '정산 판정에 쓴 실측 분(GROMO-1207). FOCUS 무기록은 0, SCREEN_TIME 미보고는 null(미계측 — 앱 "—" 표시)']

  acknowledged_at timestamptz [note: '결과 모달 확인 표시(V49, N58) — 1회 노출 가드의 정본. acknowledged_at IS NULL 조건부 원자 UPDATE 로만 세팅(리그 league_weekly_results.acknowledged_at 과 같은 모양). V49 배포 시점의 결과 4종 회차 참가 행은 now() 로 백필(이미 본 결과의 재생 방지 — OPEN 회차 행은 대상 아님)']
  display_claimed_at timestamptz [note: '표시 선점(lease) 시각(V49, B17) — 이 시각 + 2분까지가 유효 점유. 렌더 직전 재검증이 같은 쓰기로 이 값을 갱신해 리스를 연장한다(검증·연장을 나누면 마운트 전 만료 TOCTOU 가 남는다). 만료 판정은 서버 시각으로만 하고 응답에는 상대 지연(retryAfterMs)만 싣는다. ack 시 null 로 되돌린다']
  display_claim_token uuid [note: '표시 선점 토큰/버전(V49, B17) — 최초 획득 시에만 새로 발급되고 재검증은 회전시키지 않는다(갱신 응답 유실 시 ack 까지 막히는 것을 피한다). 소유 판정의 단일 축 — 앱이 렌더 직전 이 토큰으로 대조하고, ack 도 일치할 때만 성사(만료 후 재선점된 기기의 렌더·ack 차단)']

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (session_id, user_id) [unique, name: 'uq_group_challenge_bet_participants_session_user', note: '회차당 참가 1행 — 중복 참가 방어']
    (user_id, session_id) [name: 'idx_group_challenge_bet_participants_user_session', note: '참가자 스코프 조회(/me/bet-sessions·/me/challenge-results)와 탈퇴 연동의 user_id 선두 축 — 유니크는 선두가 session_id 라 못 쓴다. migration V44']
  }
}

Table group_invite_links [note: '그룹 초대 링크 원장: slug → (그룹, 초대자). (그룹, 초대자)당 1링크를 재사용한다(멱등 발급). 공유 URL = https://link.oneorthree.world/l/{slug}?g={group_id}. migration V21'] {
  id         uuid        [pk]

  slug       varchar(12) [not null, unique, note: '초대 링크 식별자. 생성 규칙은 8자(혼동 문자 제외 알파벳 23456789abcdefghjkmnpqrstuvwxyz), 규칙 변경 여지로 컬럼은 12']
  group_id   uuid        [not null, note: 'FK → groups.id — 링크가 가리키는 그룹']
  inviter_id uuid        [not null, note: 'FK → users.id — 누가 데려왔나(어트리뷰션 앵커)']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (group_id, inviter_id) [unique, note: '멱등 발급의 최후 방어선 — 동시 발급 레이스 포함']
  }
}

Table invite_link_clicks [note: '초대 링크 클릭 + 매치(설치 기기 연결) + claim(유저 연결) 상태. 별도 install 테이블 없이 클릭 행 하나가 상태 전이를 전부 가진다. migration V21'] {
  id                uuid        [pk]

  link_id           uuid        [not null, note: 'FK → group_invite_links.id']

  ip_hash           varchar(64) [not null, note: 'SHA-256(ip + LINK_IP_SALT) hex 64자 — 원본 IP 는 저장하지 않는다']
  os                varchar(16) [not null, note: "'ios' | 'android' | 'other' (Android 는 범위 외, 컬럼 여지만)"]
  user_agent        varchar(512)
  clicked_at        timestamptz [not null, default: `now()`]

  matched           boolean     [not null, default: false, note: '매치 소진 플래그 — true 면 재매치 불가(재설치 방어선)']
  matched_at        timestamptz
  matched_device_id varchar(64) [note: '앱 자체 device_id']
  app_instance_id   varchar(64) [note: 'GA4 앱스트림 결합용 Firebase app_instance_id']

  claimed_user_id   uuid        [note: 'nullable — 가입/로그인 후 유저 연결 (FK → users.id, 최초 1회만 기록)']
  claimed_at        timestamptz

  indexes {
    (ip_hash, os, clicked_at) [note: '매치 검색 전용 부분 인덱스 (WHERE matched = false) — 소진된 클릭은 인덱스에서도 제외']
    (link_id) [note: '링크별 클릭/매치 집계']
    (matched_device_id, matched_at) [note: '매치 재시도 멱등(기기별 기존 매치 조회) 전용 부분 인덱스 (WHERE matched = true)']
  }
}

// ────────────────────────────────────────────
// 3. 포커스 (집중 기록)
// ────────────────────────────────────────────

Table user_focus_tags [note: '유저가 채택한 집중 태그(필터). 태그 정체성은 default_tags, 출처는 occupation_default_tags(nullable). focus_sessions.focus_tag_id 가 참조'] {
  id      uuid         [pk]

  user_id         uuid [not null, note: 'FK → users.id']
  default_tag_id  uuid [not null, note: 'FK → default_tags.id (태그 정체성). 커스텀 태그도 default_tags에 등록 후 참조 → 유저 생성 가능']
  source_occupation_default_tag_id uuid [note: 'nullable — 추천에서 채택 시 출처(어느 직업 추천에서 왔나). 커스텀 태그면 null (FK → occupation_default_tags.id)']

  created_at timestamptz [not null, default: `now()`, note: '생성 시각']
  deleted_at timestamptz [note: '삭제 시각 (소프트 딜리트) — focus_sessions.focus_tag_id 가 참조하므로 하드 삭제 대신 소프트 딜리트']

  indexes {
    (user_id, default_tag_id) [unique, note: '동일 태그 중복 채택 방지']
  }
}

Table focus_sessions [note: '개별 집중 세션 기록 (시작~종료, 이탈 횟수/시간)'] {
  id                        uuid        [pk]

  user_id                   uuid        [note: 'nullable — 탈퇴 시 null (FK → users.id)']
  focus_tag_id              uuid        [note: 'nullable — 태그 없는 세션 허용. 참조 태그는 소프트 딜리트(하드 삭제 시 참조 무결성 파손)']
  daily_focus_stat_id       uuid        [note: 'nullable — 소속 일일 집계 (FK → daily_focus_stats.id)']

  focus_type                focus_type  [note: 'INFINITE / RANGE / POMODORO']

  started_at                timestamptz [not null, note: '세션 시작 시각']
  ended_at                  timestamptz [note: '세션 종료 시각 — 진행중(라이브) 세션이면 null (GROMO-610)']
  stat_end_at               timestamptz [note: 'nullable — 통계 귀속용 유효 종료 = min(ended_at, 완료 시점 now). ended_at 은 재업로드 중복 검사 때문에 클라 값 그대로 저장하므로, 미래 endedAt 위조가 조회 시점마다 더 세지 않도록 완료 순간 클램프를 고정 보관 (GROMO-1252). 레거시 row 는 null → 조회측이 ended_at 폴백']
  focus_seconds_by_date     jsonb       [note: 'nullable — 완료 시점에 확정한 날짜별 집중 초 (유저 존 로컬 날짜 "YYYY-MM-DD" → 초). daily_focus_stats 에 가산한 값과 동일 (GROMO-1252). 조회 집계(by-category)·앱 복원이 구간을 다시 벽시계로 자르지 않고 이 분포를 쓴다. 레거시 row 는 null → 조회측이 벽시계 클리핑 폴백']

  status                    focus_session_status [not null, default: 'ACTIVE', note: '세션 생명주기 (deleted_at 대체). 라이브 = ACTIVE(단, GROMO-610 레거시 경로로 ended_at 만 채워진 채 ACTIVE 로 남은 완료 행도 존재 — 라이브 판정은 status 가 아니라 ended_at IS NULL 로 한다). 마감 종류: COMPLETED(정상 완료) / CANCELED(유저 취소·POST 폴백 선점) / AUTO_CLOSED(서버 대신 마감 — orphan 12h 스윕 + 새 마커 시작 시 close-then-open, GROMO-1287). 집계 쿼리는 NOT IN (CANCELED, AUTO_CLOSED) 제외 목록 방식']

  total_distraction_seconds integer     [not null, default: 0, note: '집중 중 이탈 누적 시간(초)']

  created_at         timestamptz        [not null, default: `now()`]

  // (종전 note 가 광고하던 idx_focus_sessions_live 는 어느 마이그레이션에도 존재한 적이 없어
  // GROMO-1287 에서 삭제했다 — 없는 것을 문서가 있다고 말하고 있었다. 아래는 실제로 만든 것이다.)
  //
  // 「유저당 라이브 마커(ended_at IS NULL) 1개」 불변식은 현재 **서비스 레이어**가 지킨다
  // (FocusService.startFocusSession: users 행 배타 락 + close-then-open + startedAt 단조성).
  // 이를 DB 로 강제하는 부분 유니크 인덱스 — (user_id) WHERE ended_at IS NULL — 는 **후속 티켓**이다:
  // prod 롤백이 Flyway 를 유지한 채 이미지만 되돌리므로, close-then-open 이 안착하기 전에 인덱스를
  // 넣으면 롤백된 구버전 서버가 마커 회전마다 유니크 위반 500 을 낸다.
  //
  // 다만 **비고유** 부분 인덱스는 롤백해도 INSERT 를 막지 않으므로 V47 이 함께 만든다 — 매 start 가
  // 배타 락을 쥔 채 (user_id, ended_at IS NULL) 조회와 벌크 마감을 연달아 돌려, 인덱스가 없으면
  // 요청마다 풀스캔 2회에 락 보유 시간까지 길어진다.

  indexes {
    (user_id, started_at) [name: 'idx_focus_sessions_live_marker', note: '라이브 마커 조회·마감 전용 **비고유** 부분 인덱스 (WHERE ended_at IS NULL, started_at DESC). migration V47. 유니크가 아닌 이유는 위 주석 — 롤백 호환']
  }
}

Table focus_session_pomodoros [note: 'POMODORO 세션 상세 (focus_sessions 1:1, POMODORO 타입 세션만 행 존재). 타입별 필드 분리(CTI)로 focus_sessions NULL 오염 방지'] {
  id                  uuid    [pk, note: '전용 PK']

  focus_session_id    uuid    [not null, unique, note: 'FK → focus_sessions.id (1:1). focus_type = POMODORO 인 세션만']
  pomodoro_setting_id uuid    [note: 'nullable — 사용 프리셋 (FK → focus_sessions_pomodoro_setting.id)']

  focus_minutes   integer [not null, note: '뽀모도로 집중(공부) 시간(분) — 1세트 기준']
  break_minutes   integer [not null, note: '뽀모도로 휴식 시간(분) — 1세트 기준']
  set_count       integer [not null, note: '완료 세트 수']

  created_at      timestamptz [not null, default: `now()`, note: '생성 시각']
}

Table focus_sessions_pomodoro_setting [note: '뽀모도로 기본 집중/휴식 시간 프리셋(서버 관리, 하드코딩 대체)'] {
  id            uuid         [pk]

  name          varchar(255) [not null, note: '프리셋 표시명 (예: 클래식 25/5)']
  focus_minutes integer      [not null, note: '집중 시간(분)']
  break_minutes integer      [not null, note: '휴식 시간(분)']
  is_default    boolean      [not null, default: false, note: '기본 프리셋 여부 (sort_order 대신)']

  created_at    timestamptz  [not null, default: `now()`, note: '생성 시각']
  updated_at    timestamptz
  deleted_at    timestamptz  [note: '소프트 딜리트(시드 교체 여지)']
}

// ────────────────────────────────────────────
// 4. 그룹
// ────────────────────────────────────────────

Table groups [note: '스터디/챌린지 그룹'] {
  id               uuid                  [pk]
  name             varchar(50)           [not null, default: '', note: '그룹 이름']
  description      varchar(200)          [note: '그룹 소개']

  password         varchar(100)          [note: '레거시 BCrypt 해시(참여 시 확인). 공개/비공개와 무관 — 공개 여부는 is_private 가 결정']

  is_private       boolean               [not null, default: false, note: 'true면 이름 검색에서 제외되고 초대 링크(groupId)로만 참여 (V17)']

  status           group_status          [not null, default: 'WAITING', note: '챌린지 진행중 여부 파악']

  max_members      integer               [not null, note: '최대 인원']

  is_chat_enabled  boolean               [not null, default: true, note: '그룹 채팅 활성화 여부']
  chat_limit_per_person integer            [note: '1인당 채팅 가능한 횟수']

  invite_permission group_permission_scope [not null, default: 'OWNER_ONLY', note: '초대 권한 범위 (그룹 단위)']

  created_at                     timestamptz [not null, default: `now()`]
  updated_at                     timestamptz
  deleted_at                     timestamptz [note: '삭제 시각 (소프트 딜리트 감사 로그용)']

  indexes {
    // 공개 그룹 이름 fuzzy 검색용 GIN 트라이그램 인덱스 (V18, 닉네임 검색과 동형)
    //   전제 확장: CREATE EXTENSION pg_trgm  /  쿼리: name % :q ORDER BY name <-> :q
    name [type: gin, name: 'idx_groups_name_trgm', note: 'pg_trgm GIN (gin_trgm_ops) — 그룹 이름 trgm 검색, V18']
  }
}

Table group_join_codes [note: '그룹 참가 코드 (groups에서 분리, 1:1). 발급·만료·재발급 관리. 추후 활성 코드 검증·만료를 Redis(TTL)로 이관 가능 — 이 테이블이 캐시 계층 경계'] {
  group_id    uuid        [pk, note: 'FK → groups.id (1:1)']

  code        varchar(8)  [not null, unique, note: '참가 코드 (8자 랜덤 영문/숫자). 재발급 시 같은 행 UPDATE']
  status      code_status [not null, default: 'ACTIVE', note: 'ACTIVE / ENDED']
  expires_at  timestamptz [note: '만료 시각 (발급 + 24h) — 추후 Redis TTL 로 이관']

  created_at  timestamptz [not null, default: `now()`, note: '발급 시각']
  updated_at  timestamptz [note: '재발급(코드 갱신) 시각']
}

Table group_members [note: '그룹 멤버십 (역할 · 활동상태 · 알림 설정)'] {
  id                   uuid              [pk]

  user_id              uuid              [not null, note: 'FK → users.id']
  group_id             uuid              [not null, note: 'FK → groups.id']

  role                 group_member_role [not null, default: 'MEMBER', note: '방장 여부. 유령 방장(V30 이탈 처리)만 남아 활성 OWNER 가 없던 그룹은 V31 백필이 최고참 활성 멤버를 승계(GROMO-1243, created_at·id 오름차순)']
  status               group_member_status [not null, default: 'INACTIVE', note: '그룹 활동 (챌린지, 포커스) 진행 여부']

  announcement_permission group_announcement_grant [not null, default: 'DISALLOW', note: '멤버 단위 공지 작성 권한, 방장은 제외']
  notification_enabled boolean           [not null, default: true, note: '그룹 알림 수신 설정 (콕찌르기 등)']

  is_left              boolean           [not null, default: false, note: 'A-0 소프트삭제: 활성=false, 탈퇴/강퇴=true. 재가입은 이 행을 되살림(rejoin). 계정 탈퇴 정리(GROMO-801) 이전 탈퇴자의 유령 활성 행은 V30 백필이 LEFT 로 이탈 처리(GROMO-1220)']
  left_reason          varchar(10)       [null, note: 'A-0(V25) 이탈 사유: null(활성)·LEFT(자진, 재가입 허용)·KICKED(강퇴, 재가입 차단). CHECK IN (LEFT,KICKED)']

  created_at           timestamptz       [not null, default: `now()`, note: '가입 시각']
  updated_at           timestamptz
  indexes {
    // (user,group) 전체 unique — 멤버십은 1행. 재가입은 신규 삽입이 아니라 기존 행 rejoin(is_left=false로 복원).
    (user_id, group_id) [unique, note: '멤버십 1행 보장. 자진 탈퇴자 재가입=행 되살리기, 강퇴자=거절']
  }
}

Table group_announcements [note: '그룹 공지'] {
  id         uuid         [pk]

  group_id   uuid         [not null, note: 'FK → groups.id']
  user_id    uuid         [note: '작성자, 탈퇴 시 null (FK → users.id)']

  title      varchar(100) [not null, note: '공지 제목']
  content    text         [not null, note: '공지 본문']

  created_at timestamptz  [not null, default: `now()`]
  deleted_at timestamptz  [note: '삭제 시각 (소프트 딜리트). 콘텐츠 수정 불가 → 수정은 삭제 후 새 row, 옛 내용 보존']
}

// ────────────────────────────────────────────
// 5. 아이템 / 캐릭터
// ────────────────────────────────────────────

Table items [note: '상점 아이템 (장착형 EQUIPPABLE / 장식형 DECORATIVE)'] {
  id              uuid        [pk]
  name            varchar(255) [note: '아이템 이름']
  description     text        [note: '아이템 설명']
  item_type       item_type   [not null, note: 'EQUIPPABLE / DECORATIVE']
  slot_type       slot_type   [note: 'EQUIPPABLE 전용, DECORATIVE면 null']
  grade           varchar(20) [not null, note: '아이템 등급 (구 rarity, 추후 Enum 확정)']

  asset_url       varchar(255) [note: '에셋 URL']

  payment_type    payment_type [not null, note: 'CURRENCY / PREMIUM / BOTH']
  currency_price  integer     [note: 'CURRENCY·BOTH 전용, null이면 인게임 재화로 구매 불가']
  premium_price   integer     [note: 'PREMIUM·BOTH 전용, null이면 현질로 구매 불가']

  is_active       boolean     [not null, default: true, note: '상점 판매/노출 여부 (false면 신규 구매 불가·숨김). user_items.is_used(착용 여부)와 별개']

  created_at      timestamptz [not null, default: `now()`, note: '생성 시각']
  updated_at      timestamptz
}

Table user_items [note: '유저 보유 아이템 (인벤토리)'] {
  id          uuid        [pk]

  user_id     uuid        [not null, note: 'FK → users.id']
  item_id     uuid        [not null, note: 'FK → items.id']
  is_used     boolean     [not null, default: false, note: '현재 장착/사용 중 여부']

  created_at  timestamptz [not null, default: `now()`, note: '획득 시각']

  indexes {
    (user_id, item_id) [unique]
  }
}

Table character_equipment [note: '유저 캐릭터 장착 상태 (슬롯별 1개)'] {
  id            uuid      [pk]

  user_id       uuid      [not null, note: 'FK → users.id']
  user_item_id  uuid      [not null, note: '장착한 보유 아이템 (FK → user_items.id)']
  slot_type     slot_type [not null, note: '장착 슬롯']

  created_at    timestamptz [not null, default: `now()`, note: '장착 시각']

  indexes {
    (user_id, slot_type) [unique]
  }
}

Table character_generation [note: '누끼(캐릭터) 생성 이력 (append-only). 쿼터 판정용 — 가입 후 7일 무제한 → 이후 롤링 7일 내 2회. GROMO-1045, V23'] {
  id          uuid        [pk]

  user_id     uuid        [not null, note: 'FK → users.id']

  created_at  timestamptz [not null, note: '생성 시각 — 롤링 7일 윈도우 판정 기준']

  client_generation_id uuid [note: '클라 멱등키(옵션, nullable) — 재시도 시 (user_id, client_generation_id) 중복 무시로 슬롯 중복 소비 방지. V23']

  indexes {
    (user_id, created_at) [name: 'idx_character_generation_user_created_at', note: '창 내 count·슬롯 오프셋 행 조회']
    (user_id, client_generation_id) [unique, name: 'uq_character_generation_client_id', note: '멱등키 부분 유니크 — WHERE client_generation_id IS NOT NULL (키 있을 때만). V23']
  }
}

// ────────────────────────────────────────────
// 6. 리그
// ────────────────────────────────────────────
// ✅ 완벽한 티어제 적용 완료 (Flyway V12~V15 — GROMO-814·815·817). 리그는 전체 유저 단일(전역) 리더보드 +
//    티어별 시간 임계값 기반 승강. 직군(occupation)은 리그를 나누지 않고 리더보드를 좁혀 보는 필터 태그다.
//    - 멤버십 테이블 league_arena_users 제거(V14). 티어는 users.tier_level 단일 SoT(V12, 기본 1, CHECK 1~5).
//    - 랭킹은 집중 데이터(daily_focus_stats) 실시간 집계. league_arenas는 주차 앵커로 유지(started_at UNIQUE, V15).
//    - league_rank_snapshots는 arena_id 제거·전역 스코프로 추월 감지 유지(V14).
//    - league_tier_configs는 시간 임계값(promotion/relegation_time)+배지(V13). 주간 정산 결과는 league_weekly_results 로그(V12).
//    상세: docs/etc/league-prd.md §4·§7.

Table league_tier_configs [note: '리그 티어별 승강 규칙 설정. 승강은 아레나 내 순위가 아니라 티어별 주간 집중시간 임계값 기준(promotion_time/relegation_time). 리더보드는 전역 단일(전 티어 혼합), 직군은 필터 태그일 뿐(인원 제한/아레나 분할 없음). V13(GROMO-815) promotion_time/relegation_time 추가 → V14(GROMO-817) arena_size+promote/relegate/relegate_warning_count 드롭. 이제 시간 임계값 단일 기준.'] {
  tier_level            integer     [pk, note: '리그 티어 레벨 1~5 (표시명은 앱에서 매핑, 클수록 상위). 하루 구간 ×7 = 주간 임계값: 뽀시래기0~14h/예열14~28h/초집중28~42h/갓생러42~56h/집중정복자56~70h']
  badge_id              varchar     [not null, note: '티어별 배지 식별자 (앱이 에셋 매핑; slug 값은 Infra 에셋 식별 규칙). GROMO-451']

  promotion_time        integer     [not null, note: '승급 임계값(주 단위 초) — 지난주 누적이 이 값 이상이면 다음 티어로 승급. = 현재 티어 상한(다음 티어 하한)']
  relegation_time       integer     [not null, note: '강등 임계값(주 단위 초) — 지난주 누적이 이 값 미만이면 이전 티어로 강등. = 현재 티어 하한. (경계 부등호·T1 하한 0·무활동 처리는 league-prd.md §7 미결)']

  updated_at            timestamptz
  deleted_at            timestamptz [note: '소프트 딜리트']
}

Table league_arenas [note: '주간 리그 컨테이너(주차 경계·상태 보관). 한 주=1 row(전역) 앵커 — started_at UNIQUE(V15)·status(ACTIVE/ENDED)로 배치 멱등성. tier_level FK는 V14(GROMO-817)에서 제거돼 독립 테이블. 향후 듀오링고식 리그(부활) 재사용 — league-prd.md §4·§7-B·§7-D'] {
  id            uuid                [pk, note: '아레나 고유 식별자']

  started_at    timestamptz         [not null, note: '리그 주차 시작(UTC)']

  status        league_arena_status [not null, default: 'ACTIVE', note: 'ACTIVE / ENDED']

  ended_at      timestamptz         [note: '마감 시각']
  created_at    timestamptz         [not null, default: `now()`]
  updated_at    timestamptz

  indexes {
    started_at [unique, name: 'uq_league_arenas_started_at', note: '주차당 전역 anchor 1행 — 동시 배치 중복 생성 방지 GROMO-817, V15']
  }
}

// league_arena_users: 멤버십 테이블 — 전역 주간 리그 전환(GROMO-817, V14)으로 DROP.
//   주간 누적은 저장하지 않고 daily_focus_stats 실시간 집계, 티어는 users.tier_level 로 대체.

Table league_rank_snapshots [note: '전역 일간 순위 스냅샷. 매일 배치가 전역 순위를 저장 → 다음날 "어제↔오늘" 비교로 추월 감지. arena_id는 전역 순위제 전환(V14, GROMO-817)으로 제거.'] {
  id          uuid    [pk]

  user_id     uuid    [not null, note: 'FK → users.id']
  rank        integer [not null, note: '그날 전역 순위 (index+1)']

  created_at  date    [not null, note: '스냅샷 KST 날짜 (구 captured_on) — 어제↔오늘 비교 키']

  indexes {
    (user_id, created_at) [unique, name: 'uq_league_rank_snapshots_user_day', note: '전역 순위제(V14) — arena_id 제거']
    created_at [name: 'idx_league_rank_snapshots_created_at', note: '일간 순위 비교 잡 날짜 단일 조회 seek']
  }
}

Table league_weekly_results [note: '주간 리그 정산 결과 로그 (GROMO-814, V12). 티어 임계값 기반 승강 결과를 유저·주차별 1행 기록 — 결과 발표/미확인 배지용'] {
  id                  uuid        [pk]

  user_id             uuid        [not null, note: 'FK → users.id']
  week_start_at       timestamptz [not null, note: '정산 대상 주차 시작(UTC)']

  previous_tier_level integer     [not null, note: '정산 전 티어 (CHECK BETWEEN 1 AND 5)']
  new_tier_level      integer     [not null, note: '정산 후 티어 (CHECK BETWEEN 1 AND 5)']

  result              league_weekly_result [not null, note: 'PROMOTED / STAY / RELEGATED (CHECK)']

  focus_seconds       integer     [not null, note: '지난주 누적 집중 시간(초) — 승강 판정 근거 (CHECK >= 0)']

  acknowledged_at     timestamptz [note: '유저가 결과 확인한 시각 — null이면 미확인(배지 노출)']
  created_at          timestamptz [not null, note: '정산 기록 시각']

  indexes {
    (user_id, week_start_at) [unique, name: 'uq_league_weekly_results_user_week']
    (user_id, created_at) [name: 'idx_league_weekly_results_user_created', note: '최근 결과 조회(created_at DESC)']
    (week_start_at, result) [name: 'idx_league_weekly_results_week_result']
  }
}

// ────────────────────────────────────────────
// 7. 재화 / 보상
// ────────────────────────────────────────────

Table user_streaks [note: '유저 연속 집중 기록(스트릭)'] {
  user_id           uuid [pk, note: 'FK → users.id']

  streak_count         integer [not null, default: 0, note: '현재 연속일']
  longest_streak_count integer [not null, default: 0, note: '최장 연속일']
  last_session_date date    [note: '마지막 집중 날짜']

  updated_at                  timestamptz
  deleted_at                  timestamptz [note: '탈퇴 시각 (소프트 딜리트)']
}

Table currency_transactions [note: '재화 획득/소비 거래 내역'] {
  id              uuid            [pk]

  user_id         uuid            [not null, note: 'FK → users.id']

  amount          integer         [not null, note: '변동 절대값(항상 양수). 증감 방향은 type 이 정한다 — 코드가 EARN/SPEND 를 type 별로 고정 (BET_STAKE=차감, BET_PAYOUT/BET_REFUND=지급)']
  type            currency_type   [not null, note: 'SESSION_COMPLETE / STREAK_BONUS / PURCHASE / BET_STAKE / BET_PAYOUT / BET_REFUND']

  idempotency_key varchar(255)    [unique, note: '멱등성 키(영속 보루) — 중복 적립/쿠폰 발급 차단. 컨벤션: session:{sessionId} / streak:{userId}:{yyyy-mm-dd} / purchase:{orderId} / coupon:{couponId} / bet:{betId}:stake|payout|refund:{userId}(V19 서버 주도 경로가 첫 실배선). Redis SETNX는 앞단 1차 차단']

  created_at   timestamptz     [note: '거래 시각']
}

// ────────────────────────────────────────────
// 8. LLM / 집계
// ────────────────────────────────────────────

Table daily_focus_stats [note: '유저별 일일 집중 집계 (LLM·리포트용)'] {
  id                          uuid    [pk]
  user_id                     uuid    [note: 'nullable — 탈퇴 유저 익명 보존 (FK → users.id)']

  date                        date    [not null, note: '일별 집계 버킷 날짜 — 현재 UTC 기준(FocusService.statDate = endedAt 을 UTC 로 환산). ticket 803 에서 country_code 존 기준으로 전환 예정']

  total_focus_seconds         integer [not null, default: 0, note: '일일 누적 집중 시간(초) — GROMO-642, 분 내림 손실 제거']
  session_count               integer [not null, default: 0, note: '일일 세션 수']
  total_distraction_seconds   integer [not null, default: 0, note: '일일 이탈 총 시간']
  is_focus_time_goal_achieved boolean [not null, default: false, note: '집중 목표 달성 여부']

  updated_at                  timestamptz

  indexes {
    (user_id, date) [unique]
    date [name: 'idx_daily_focus_stats_date', note: '기간 집계 date BETWEEN range scan (user_id 선행 아님) GROMO-753, V11']
  }
}

Table daily_screen_time_stats [note: '유저별 일일 스크린타임 집계 (앱이 매일 23:59 전송, GROMO-551 로 daily_focus_stats 에서 분리)'] {
  id                           uuid    [pk]
  user_id                      uuid    [note: 'nullable — 탈퇴 유저 익명 보존 (FK → users.id)']

  date                         date    [not null, note: 'KST 로컬 날짜 (GROMO-1259 — 저장축 KST 고정. 구 country_code 파생 존(GROMO-561)은 폐지, 해외 유저 어긋남은 L5 수용)']

  total_screen_time_minutes    integer [note: '앱 전송 실제 스크린타임(분). null = 미집계(V38, GROMO-1267) — "0분 사용"과 구분(FR-16). 판정은 null 을 미보고(미달성)로 해석']
  is_screen_time_goal_achieved boolean [not null, default: false, note: '스크린타임 목표 달성 여부 (클라 계산값)']
  is_screen_time_finalized     boolean [not null, default: false, note: '오늘 row 확정 여부 — interim(false)이면 현재 목표로 재계산, final(true)이면 클라 스냅샷 사용. GROMO-805, V10']

  updated_at                   timestamptz

  indexes {
    (user_id, date) [unique]
  }
}

// ────────────────────────────────────────────
// 9. 알림 (서버 푸시)
// ────────────────────────────────────────────

Table notification_sent_logs [note: '발송 이력 로그 (GROMO-579) + 사건 단위 클레임 파이프라인 (GROMO-1417 · N41 · N44, V45). 종전 트리거는 실발송(FCM SENT) 건만 기록하고, 내기 사건 알림(BET_RESULT · BET_VOID_REFUND · BET_SILENT_FLUSH)은 발송 전 PENDING 선점 → SENT 전이로 다중 인스턴스 이중 발송을 막는다. migration v26 → v45'] {
  id             uuid        [pk]

  user_id        uuid        [not null, note: 'FK → users.id (수신자)']

  type           varchar     [not null, note: "발송 종류 (RANK_OVERTAKE · BET_RESULT · CHALLENGE_* · FRIEND_* · BET_VOID_REFUND · BET_SILENT_FLUSH)"]
  target_user_id uuid        [note: '대상 유저(라이벌) — 추월=대표 라이벌, 없으면 null (nullable, FK → users.id)']

  sent_at        timestamptz [note: '실발송 시각 — PENDING/DEFERRED 클레임 행은 발송 전이라 null (V45 에서 NOT NULL 해제)']

  kind           varchar     [not null, note: '사건 dedup 축의 종류 (V45) — 기존 행은 type 백필. 유니크 (user_id, kind, subject_id) 의 축']
  subject_id     uuid        [note: '사건 대상 id (V45) — 내기 계열은 회차 id. 레거시 행은 null (유니크에서 서로 충돌하지 않음)']
  status         varchar     [not null, default: "'SENT'", note: "클레임 상태 (V45): 'PENDING'(선점, 리스 10분) | 'DEFERRED'(조용한 시간 이월 — N44) | 'SENT'"]
  claimed_at     timestamptz [note: '선점 시각 (V45) — PENDING 리스 만료(10분) 판정 기준']
  group_id       uuid        [note: '묶음 메타 (V45) — (유저 × 그룹 × 슬롯) 묶음 축, dedup 키 아님 (N20 · N41)']
  slot_at        timestamptz [note: '묶음 메타 (V45) — 사건이 속한 15분 시간슬롯 (이월돼도 원래 슬롯 유지 — N44)']
  next_attempt_at timestamptz [note: '이월 클레임의 다음 시도 시각 (V45) — 이월 시점의 조용한 시간 종료 시각. 없으면 조용한 시간 내내 매 틱 같은 DEFERRED 전량을 재처리한다']

  indexes {
    (user_id, kind, subject_id) [unique, name: 'uq_notification_sent_logs_user_kind_subject', note: '사건 단위 선점 유니크 — INSERT ON CONFLICT DO NOTHING 대상 (N41)']
    (status, next_attempt_at, claimed_at) [name: 'idx_notification_sent_logs_unsent_claims', note: "부분 인덱스 WHERE status <> 'SENT' — 미발송 클레임 스캔 + 도래한 이월분만 조회"]
  }
}

Table shedlock [note: 'ShedLock 분산 락 (GROMO-1283 · policy §E4, V45) — 챌린지·정산·알림 크론의 멀티 인스턴스 중복 실행 차단. shedlock-provider-jdbc-template 표준 스키마'] {
  name       varchar(64)  [pk, note: '락 이름 — @SchedulerLock(name) 크론별 고유']
  lock_until timestamp    [not null]
  locked_at  timestamp    [not null]
  locked_by  varchar(255) [not null]
}

// ────────────────────────────────────────────
// Refs
// ────────────────────────────────────────────

// 유저 / 인증
Ref: social_accounts.user_id > users.id
Ref: user_screen_time_settings.user_id - users.id
Ref: user_wallets.user_id - users.id
Ref: bot_profiles.user_id - users.id
Ref: friendships.from_user_id > users.id
Ref: friendships.to_user_id > users.id
Ref: user_notification_settings.user_id - users.id
Ref: user_blocks.blocker_id > users.id
Ref: user_blocks.blocked_id > users.id

// 챌린지
Ref: group_challenges.group_id > groups.id
Ref: group_challenge_durations.challenge_id - group_challenges.id
Ref: group_challenge_windows.challenge_id - group_challenges.id
Ref: group_challenge_members.group_challenge_id > group_challenges.id
Ref: group_challenge_members.user_id > users.id

// 챌린지 내기 (V19 · V39 2계층 재편)
Ref: group_challenge_bets.group_id > groups.id
Ref: group_challenge_bets.challenge_id - group_challenges.id
Ref: group_challenge_bet_sessions.bet_id > group_challenge_bets.id
Ref: group_challenge_bet_sessions.group_id > groups.id
Ref: group_challenge_bet_sessions.challenge_id > group_challenges.id
Ref: group_challenge_bet_participants.session_id > group_challenge_bet_sessions.id
Ref: group_challenge_bet_participants.user_id > users.id

// 포커스
Ref: user_focus_tags.user_id > users.id
Ref: user_focus_tags.default_tag_id > default_tags.id
Ref: user_focus_tags.source_occupation_default_tag_id > occupation_default_tags.id
Ref: focus_sessions.user_id > users.id
Ref: focus_sessions.focus_tag_id > user_focus_tags.id
Ref: focus_sessions.daily_focus_stat_id > daily_focus_stats.id
Ref: focus_session_pomodoros.focus_session_id - focus_sessions.id
Ref: focus_session_pomodoros.pomodoro_setting_id > focus_sessions_pomodoro_setting.id

// 그룹
Ref: group_join_codes.group_id - groups.id
Ref: group_members.user_id > users.id
Ref: group_members.group_id > groups.id
Ref: group_announcements.group_id > groups.id
Ref: group_announcements.user_id > users.id

// 초대 링크 (V21)
Ref: group_invite_links.group_id > groups.id
Ref: group_invite_links.inviter_id > users.id
Ref: invite_link_clicks.link_id > group_invite_links.id
Ref: invite_link_clicks.claimed_user_id > users.id

// 아이템 / 캐릭터
Ref: user_items.user_id > users.id
Ref: user_items.item_id > items.id
Ref: character_equipment.user_id > users.id
Ref: character_equipment.user_item_id > user_items.id
Ref: character_generation.user_id > users.id

// 리그
// league_arenas: tier_level FK 제거(V14) — 독립 앵커 테이블. league_arena_users: DROP(V14).
Ref: league_rank_snapshots.user_id > users.id
Ref: league_weekly_results.user_id > users.id
Ref: pinned_users.user_id > users.id
Ref: pinned_users.pinned_user_id > users.id

// 재화 / 보상
Ref: user_streaks.user_id - users.id
Ref: currency_transactions.user_id > users.id

// LLM / 집계
Ref: user_focus_time_settings.user_id - users.id
Ref: daily_focus_stats.user_id > users.id
Ref: daily_screen_time_stats.user_id > users.id

// 알림
Ref: notification_sent_logs.user_id > users.id
Ref: notification_sent_logs.target_user_id > users.id

// occupation 마스터 (GROMO-626, 하이브리드 — Enum 유지 + FK 물려놓기)
Ref: users.occupation > occupations.code
Ref: occupation_default_tags.occupation > occupations.code
Ref: occupation_default_tags.default_tag_id > default_tags.id
