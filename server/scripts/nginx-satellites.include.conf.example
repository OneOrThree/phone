# 인프라 소유 server 블록용 예시. 실제 호스트와 시크릿은 인프라가 주입한다.
# Cloudflare CIDR만 set_real_ip_from으로 신뢰하고 CF 외 origin 접근을 차단해
# $remote_addr를 검증된 방문자 IP로 만든 뒤 적용한다. 임의 CF-Connecting-IP를 믿지 않는다.
# __BUSINESS_UPSTREAM__, __NOTIFICATION_UPSTREAM__은 사설 host:port다.
# __LINK_HOST__는 최종 공개 도메인의 DNS 이전과 독립적인 실제 Vercel origin host다.
# 공통 헤더는 nginx-satellites-proxy-headers.conf.example에서 별도 파일로 생성한다.
# 기존 정규식 /api 라우팅보다 이 include가 먼저 평가돼야 한다.

# 시스템 §2.1의 유일한 Notification 공개 표면. 서비스가 콘솔 Bearer·actor를 검증한다.
location ^~ /internal/admin/ {
    proxy_pass http://__NOTIFICATION_UPSTREAM__;
    proxy_set_header Host $host;
    proxy_connect_timeout 2s;
    proxy_read_timeout 120s;
    proxy_next_upstream off;
}
location ^~ /internal/ { return 404; }
location = /internal { return 404; }
location ^~ /actuator/ { return 404; }
location = /actuator { return 404; }
# management(9091)는 사설망에서만 접근한다.

location = /api/v1/users/me/device-token {
    proxy_pass http://__BUSINESS_UPSTREAM__;
    include /etc/nginx/snippets/gromo-satellites-proxy-headers.conf;
}
location = /api/v1/users/me/notification-settings {
    proxy_pass http://__BUSINESS_UPSTREAM__;
    include /etc/nginx/snippets/gromo-satellites-proxy-headers.conf;
}
location ~ "^/api/v1/groups/[0-9a-fA-F-]{36}/invite-link$" {
    proxy_pass http://__BUSINESS_UPSTREAM__;
    include /etc/nginx/snippets/gromo-satellites-proxy-headers.conf;
}
location = /api/v1/invite-links/claim {
    proxy_pass http://__BUSINESS_UPSTREAM__;
    include /etc/nginx/snippets/gromo-satellites-proxy-headers.conf;
    proxy_read_timeout 14s;
}
location ~ "^/api/v1/me/challenge-results/[0-9a-fA-F-]{36}/(claim|ack)$" {
    proxy_pass http://__BUSINESS_UPSTREAM__;
    include /etc/nginx/snippets/gromo-satellites-proxy-headers.conf;
}

# §7.2 3~4단계 전용: legacy write drain 후에만 Business 호환 경로를 적용한다.
location = /l/match {
    proxy_pass http://__BUSINESS_UPSTREAM__;
    include /etc/nginx/snippets/gromo-satellites-proxy-headers.conf;
    proxy_read_timeout 5s;
}
# 정지 창에는 랜딩을 점검 응답으로 유지한다. 302로 먼저 열지 않는다.
location ^~ /l/ { return 503; }

# §7.2 5단계: IMPORT_CLOSED·import drain 후 위의 두 /l 블록을 아래 하나로 교체한다.
# 같은 reload로 랜딩·match를 넘기며 claim 목적지도 준비됐는지 별도로 확인한다.
# 그 뒤 호환 인플라이트 drain → COMPAT_MATCH_HANDLER_ENABLED=false 순서다.
# 구 앱 /l/match 경로 자체는 유지한다. DNS 이전은 두 경로가 Neon을 본 다음이다.
#
# location ^~ /l/ {
#     proxy_pass https://__LINK_HOST__;
#     proxy_set_header Host __LINK_HOST__;
#     proxy_ssl_server_name on;
#     proxy_ssl_name __LINK_HOST__;
#     proxy_ssl_verify on;
#     proxy_ssl_trusted_certificate /etc/ssl/cert.pem;
#     proxy_set_header X-Link-Client-IP $remote_addr;
#     proxy_set_header X-Link-Proxy-Secret "__LINK_PROXY_SECRET__";
#     proxy_set_header Authorization "";
#     proxy_set_header Cookie "";
#     proxy_connect_timeout 2s;
#     proxy_read_timeout 5s;
#     proxy_next_upstream off;
# }
# 위 최종 전환과 함께 AASA만 Link origin으로 넘긴다. 기존 API의 나머지 location은 유지한다.
