#     proxy_set_header Host __LINK_HOST__;
#     proxy_ssl_server_name on;
#     proxy_ssl_name __LINK_HOST__;
#     proxy_ssl_verify on;
#     proxy_ssl_trusted_certificate /etc/ssl/cert.pem;
#     proxy_set_header Authorization "";
