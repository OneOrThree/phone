# dev HTTPS server 블록에서 기존 location 두 개를 이 include로 교체한다.
# Business·Realtime은 호스트 loopback만 듣는다. Data API는 Docker 내부 호출과
# 127.0.0.1:8080의 CD 헬스 검사에만 쓴다.
location ^~ /internal/ { return 404; }
location = /internal { return 404; }
location ^~ /actuator/ { return 404; }
location = /actuator { return 404; }

# 앱의 공개 Business API와 현재 필요한 /api/v1 호환 표면만 허용한다.
location ~ ^(?:/(?:auth/sessions|me|islands|focus-sessions|invitations|rankings|statistics|screens|link-previews|friends|letters|blocks|customization)(?:/|$)|/api/v1/(?:users/me/(?:device-token|notification-settings)$|link-previews(?:/|$))) {
    proxy_pass http://127.0.0.1:8083;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-User-Id "";
    proxy_set_header X-Caller "";
    proxy_set_header X-Caller-Id "";
    proxy_set_header X-Internal-Caller "";
    proxy_set_header X-Service-Caller "";
    proxy_set_header X-Link-Client-IP "";
    proxy_set_header X-Link-Proxy-Secret "";
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Real-IP "";
    proxy_set_header CF-Connecting-IP "";
    proxy_connect_timeout 2s;
    proxy_read_timeout 30s;
    proxy_next_upstream off;
}

# dev 호스트 Nginx 에는 MV-D09 로 /static/ 블록이 이미 있다 — 그대로 두고 이 블록을 중복 추가하지 않는다(중복이면 nginx -t 실패).
# location 안의 add_header 는 server 레벨 add_header 를 상속하지 않는다 — 공통 보안 헤더가 server 블록에 있으면 여기 다시 적는다
# (이 파일에는 server 블록이 없어 복제할 헤더가 없다).
# 카탈로그 이미지(GROMO-2331·맵 에셋 MV-D09) — 내용 해시가 파일명에 들어간 불변 URL 이라 1년 캐시한다.
# 파일은 Business 를 거치지 않고 Nginx 가 디스크에서 직접 준다(로컬은 compose 볼륨, dev 는 VM 디스크 수동 복사).
location ^~ /static/ {
    root /usr/share/nginx/html;
    add_header Cache-Control "public, max-age=31536000, immutable";
    gzip off;
}

# 2.0 앱의 islandRealtime.ts가 이 WSS 경로로 연결한다. 인증은 STOMP CONNECT에서 검사한다.
# 유휴 연결 유지(GROMO-2341): 서버·앱이 STOMP heartbeat 10s/10s 를 주고받으므로 살아 있는 연결은 10초마다 양방향
# 바이트가 흐른다. read·send 3600s 는 «죽은 연결 정리»가 아니라 상한일 뿐이다 — 끊긴 상대는 Realtime 이 heartbeat
# 3회(30s) 미수신으로 닫는다. send 를 기본 60s 로 두면 서버→앱 방향만 조용한 구간에서 프록시가 먼저 끊을 수 있어 명시한다.
# 1.x 의 /ws/chat 은 이 include 가 열지 않는다(2.0 표면만 둔다).
location = /ws/realtime {
    proxy_pass http://127.0.0.1:8081;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 2s;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_next_upstream off;
}

# 공개 헬스는 Business만 나타낸다. Data의 /health는 dev 호스트 내부에서만 검사한다.
location = /health {
    proxy_pass http://127.0.0.1:8083;
    proxy_next_upstream off;
}

# 옛 Data API 기본 프록시는 끝낸다. 미명시 경로는 2.0 서비스에 전달하지 않는다.
location / { return 404; }
