# /etc/nginx/snippets/gromo-satellites-proxy-headers.conf로 생성한다.
# 이 파일은 비밀을 포함하므로 0600으로 저장한다. nginx와 Business가 같은 값을 사용한다.
proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header Connection "";
proxy_set_header X-Link-Client-IP $remote_addr;
proxy_set_header X-Link-Proxy-Secret "__LINK_PROXY_SECRET__";
proxy_set_header X-Real-IP "";
proxy_set_header CF-Connecting-IP "";
proxy_connect_timeout 2s;
proxy_next_upstream off;
