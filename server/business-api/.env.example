# Business API 환경변수 예시. 실제 값은 Secrets Manager(gromo/<env>/env) → 서비스별 env writer →
# compose 로 전달된다(A22 ㋯ · 시스템 §2.4).
#
# ⚠️ 새 키를 저장소에 추가하는 것만으로는 컨테이너에 닿지 않는다 — 현 dev 배포의 env 생성기는
#    «고정 허용목록»에 있는 키만 출력한다. 아래 필수 6개가 그 목록에 없으면 이 서비스는 부팅에서
#    fail-fast 한다(그 실패가 배포 게이트다). 목록 추가는 통합 담당자(C)의 몫이다.

# ── 필수 (비면 부팅 실패) ──────────────────────────────────────────────────
# legacy issuer(Data API)와 «같은 값». 전환 기간에 이 서비스는 AT 를 검증만 한다(A7).
JWT_SECRET=

# caller 별로 «분리된» 서비스 토큰 3종(A22 ㊀ — 총 7종 중 Business 몫).
# 공유하면 수신 측이 호출자를 구분 못 해 허용목록이 합쳐지고 한쪽 유출이 다른 쪽 명령을 연다.
SVC_TOKEN_BIZ_TO_DATA=
SVC_TOKEN_BIZ_TO_NOTI=
SVC_TOKEN_BIZ_TO_LINK=

# 상류 주소.
DATA_API_BASE_URL=http://data-api:8080
NOTIFICATION_BASE_URL=http://notification:8082
LINK_BASE_URL=https://link.oneorthree.world

# ⚠️ 기존 운영 값을 «그대로» 넘긴다. 새로 만들면 기존에 저장된 모든 해시와 대조가 불가능해져
#    진행 중이던 매치 후보가 전부 무효가 된다(A22 ⓕ · 계약 §7 변경 금지).
LINK_IP_SALT=

# ── 프록시 IP 전달 (정지 창 진입 전 필수) ──────────────────────────────────
# legacy nginx 가 원본 IP 를 전용 헤더로 실어 보낸다. 비어 있으면 그 겹을 적용하지 않는다 —
# 정지 창 진입 전에 반드시 채운다(계약 §4).
LINK_PROXY_SECRET=
# 신뢰할 IP 헤더. 기본 X-Link-Client-IP 하나다.
# ⚠️ X-Forwarded-For 를 넣지 말 것: Vercel 이 그 헤더를 덮어쓰므로 값이 살아 오지 않고,
#    오리진에 직접 붙은 호출자는 첫 토큰을 지어낼 수 있다.
LINK_TRUSTED_IP_HEADERS=X-Link-Client-IP

# ── 이관 정지 창 (전부 기본 꺼짐) ──────────────────────────────────────────
# 한시 /l/match 핸들러. 컷오버 후 제거가 계약이다(A22 ㊫).
COMPAT_MATCH_HANDLER_ENABLED=false
# 구 정지 스냅샷 → Neon import 계약이 준비됐는가.
# ⚠️ false 인 동안은 요청에 migrationId 를 «싣지 않는다» — 링크 서버는 그 필드가 있으면 import 모드로
#    들어가 openRun 을 요구하고 IMPORT_CLOSED 이후엔 빈 배열을 보내도 503 이다.
COMPAT_IMPORT_CONTRACT_READY=false
COMPAT_MIGRATION_ID=

# claim 동기 확정 실패를 202 + 내구 큐로 접어도 되는가.
# ⚠️ 기본 false 다. 202 는 「나중에 누가 끝낸다」는 약속인데 그 주체는 아래 재개 CLI 뿐이고,
#    CLI 가 돌지 않는 평상시에 202 를 주면 큐만 쌓이고 아무도 끝내지 않는 영구 대기가 된다.
#    정지 창에만 켜고, CLI 로 «미완료 0» 을 확인한 뒤 끈다.
BUSINESS_COMPAT_CLAIM_QUEUE_REPLAY_ENABLED=false

# ── 재개 CLI (일회성 job 에서만) ───────────────────────────────────────────
# ⚠️ 서빙 컨테이너에는 «절대» 넣지 않는다. 이 값이 켜지면 부팅 직후 재개가 돌고, 실패가 남으면
#    프로세스가 비정상 종료한다(그게 「미완료 0」 gate 다). 같은 이미지를 별도 job 으로 띄울 때만 쓴다.
# BUSINESS_CLAIM_REPLAY_ENABLED=true

# ── 파일 미리보기 (GROMO-1747) ─────────────────────────────────────────────
# 전용 Redis. A19 네임스페이스 표의 cache:business:* 소유자로서 «자기 캐시»만 담는다 —
# 도메인 정본이 아니라 사본이고, 비워도 다음 요청이 다시 만든다.
BUSINESS_REDIS_HOST=business-redis
BUSINESS_REDIS_PORT=6379
# A22 ㋺: 배포 준비 도구가 cache:business:* 전용 ACL과 암호를 주입한다.
BUSINESS_REDIS_USERNAME=business
BUSINESS_REDIS_PASSWORD=

# 공개 Drive 메타데이터 조회 키. 비면 Drive 경로만 못 쓰고 나머지 미리보기는 동작한다.
GOOGLE_DRIVE_API_KEY=

# 로그 파일 경로(로테이션 20MB × 7일). 컨테이너에서는 /app/logs 볼륨이다.
BUSINESS_LOG_PATH=logs/business-api.log

# ── 포트 ───────────────────────────────────────────────────────────────────
# compose 가 8080 을 준다. 관리 포트 9091 은 호스트에 publish 하지 않는다 —
# 포트 격리가 /actuator/* 를 사설로 유지하는 유일한 수단이다.
SERVER_PORT=8080
