# ── 전역 규칙만 둔다 — 앱 전용은 app/app-dev/.gitignore, 서버 전용은 server/data-api/.gitignore ──

# 에디터·OS·도구 로컬 산출물
.DS_Store
.idea/
.vscode/
.vs_code
.gstack/
.superpowers/

# Claude 하네스 — settings.json·commands/·agents/ 는 추적, 개인 로컬 파일만 무시
**/.claude/settings.local.json
.claude/worktrees/

# 개인 기획 스크래치(/doc)·작업 일지(/logs) — 팀 공유 문서 /docs 는 추적
/doc/
/logs/

# 환경변수 (.env.local·.env.production 류까지 — 예제 파일만 추적)
*.env
.env*
!.env.example
