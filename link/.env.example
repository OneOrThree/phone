# 로컬 복사 전용. 실제 값은 Vercel 환경별 설정에 저장한다.
DATABASE_URL=postgresql://link:local-only@localhost:5432/link
LINK_BASE_URL=http://localhost:3000
# 기존 Data의 값을 그대로 이관한다. 새 salt로 바꾸면 열린 3시간 매치 창이 끊긴다.
LINK_IP_SALT=
LINK_PROXY_SECRET=
SVC_TOKEN_BIZ_TO_LINK=
SVC_TOKEN_DATA_TO_LINK=
LINK_CAPABILITY_KEY=
# 이관 동안 필수. 완결된 IMPORT_CLOSED가 없으면 직접 쓰기를 열지 않는다.
LINK_MIGRATION_ID=
LINK_MIGRATION_TOKEN=
CONSOLE_SESSION_KEY=
# node scripts/hash-password.mjs로 각각 다른 비밀번호의 해시를 만든다.
CONSOLE_PASSWORD_1_HASH=
CONSOLE_PASSWORD_2_HASH=
CONSOLE_PASSWORD_3_HASH=
CONSOLE_SUDO_HASH=
NOTIFICATION_DEV_BASE_URL=
NOTIFICATION_PROD_BASE_URL=
SVC_TOKEN_CONSOLE_TO_NOTI_DEV=
SVC_TOKEN_CONSOLE_TO_NOTI_PROD=
# 로컬에서만 사용. Vercel 직접 요청은 플랫폼 IP 헤더를 사용한다.
LOCAL_CLIENT_IP=127.0.0.1
LINK_STORE_IOS_URL=https://apps.apple.com/kr/app/gromo-grow-motivation/id6774498679
GA4_ENABLED=false
GA4_FIREBASE_APP_ID=
GA4_APP_API_SECRET=
GA4_WEB_MEASUREMENT_ID=
GA4_WEB_API_SECRET=
DEPLOY_ENV=local
# 배포 앱의 실제 Android 서명값을 확인한 뒤 설정한다. 없으면 assetlinks는 404다.
ANDROID_PACKAGE_NAME=com.oneorthree.gromo
ANDROID_SHA256_FINGERPRINTS=
